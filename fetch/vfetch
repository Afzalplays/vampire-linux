#!/usr/bin/env bash
# Vampire Fetch - system information display. SPDX-License-Identifier: MIT
set -u

RED=$'\033[38;5;196m'
WHITE=$'\033[97m'
DIM=$'\033[2m'
RESET=$'\033[0m'
MUTED=$'\033[38;5;245m'

HOST=$(hostname 2>/dev/null || printf 'unknown')
WHO=$(id -un 2>/dev/null || printf 'user')
OS='Vampire OS x86_64'
if [ -r /etc/os-release ]; then
  PRETTY=$(sed -n 's/^PRETTY_NAME=//p' /etc/os-release | head -n 1 | tr -d '"')
  [ -n "$PRETTY" ] && OS=$PRETTY
fi
KERNEL=$(uname -r 2>/dev/null || printf 'Unknown')
UPTIME=$(uptime -p 2>/dev/null | sed 's/^up //' || true)
[ -n "$UPTIME" ] || UPTIME=Unknown

PACKAGES=Unknown
if [ -r /var/lib/vpm/installed.json ] && command -v python3 >/dev/null 2>&1; then
  PACKAGES=$(python3 -c 'import json; p=json.load(open("/var/lib/vpm/installed.json")); print(len(p.get("packages", {})))' 2>/dev/null || printf 'Unknown')
elif command -v apk >/dev/null 2>&1; then
  PACKAGES=$(apk info 2>/dev/null | wc -l | tr -d ' ')
elif command -v dpkg-query >/dev/null 2>&1; then
  PACKAGES=$(dpkg-query -f '.' -W 2>/dev/null | wc -c | tr -d ' ')
elif command -v rpm >/dev/null 2>&1; then
  PACKAGES=$(rpm -qa 2>/dev/null | wc -l | tr -d ' ')
elif command -v pacman >/dev/null 2>&1; then
  PACKAGES=$(pacman -Q 2>/dev/null | wc -l | tr -d ' ')
fi

SHELL_NAME=$(basename "${SHELL:-unknown}" 2>/dev/null || printf 'Unknown')
DISPLAY_INFO=TTY
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
  DISPLAY_INFO="Wayland ${WAYLAND_DISPLAY}"
elif [ -n "${DISPLAY:-}" ]; then
  DISPLAY_INFO="X11 ${DISPLAY}"
fi
if command -v xrandr >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
  RES=$(xrandr 2>/dev/null | awk '/\*/ {print $1; exit}')
  [ -n "$RES" ] && DISPLAY_INFO="$RES"
fi
EDITION=${VAMPIRE_EDITION:-}
OS_CONF=${VAMPIRE_OS_CONF:-/etc/vampire/os.conf}
if [ -z "$EDITION" ] && [ -r "$OS_CONF" ]; then
  EDITION=$(sed -n 's/^EDITION="\([^"]*\)"$/\1/p' "$OS_CONF" | head -n 1)
fi
case "$EDITION" in
  server)
    HOST_NAME='Vampire Server'
    DE_NAME=${XDG_CURRENT_DESKTOP:-None (headless)}
    WM_NAME=${XDG_SESSION_DESKTOP:-None}
    ;;
  *)
    HOST_NAME='Vampire Desktop'
    DE_NAME=${XDG_CURRENT_DESKTOP:-Vampire Desktop}
    WM_NAME=${XDG_SESSION_DESKTOP:-Unknown}
    [ -n "$WM_NAME" ] || WM_NAME=Unknown
    ;;
esac
if [ -n "${XDG_SESSION_TYPE:-}" ]; then
  WM_NAME="$WM_NAME (${XDG_SESSION_TYPE})"
fi
THEME=${GTK_THEME:-Vampire Dark}
TERM_NAME=${TERM_PROGRAM:-${TERM:-Unknown}}
CPU=$(awk -F: '/model name/ {sub(/^[ \t]+/, "", $2); print $2; exit}' /proc/cpuinfo 2>/dev/null)
[ -n "$CPU" ] || CPU=Unknown
GPU='Not detected'
if command -v lspci >/dev/null 2>&1; then
  DETECTED_GPU=$(lspci 2>/dev/null | awk -F': ' '/VGA compatible controller|3D controller|Display controller/ {print $2; exit}')
  [ -n "$DETECTED_GPU" ] && GPU=$DETECTED_GPU
fi
MEMORY=$(awk '/MemTotal:/ {t=$2} /MemAvailable:/ {a=$2} END {if(t>0) printf "%.1f GiB / %.1f GiB", (t-a)/1048576, t/1048576; else print "Unknown"}' /proc/meminfo 2>/dev/null)
IP=$(hostname -I 2>/dev/null | awk '{print $1}')
[ -n "$IP" ] || IP='Not detected'
LOCALE=${LC_ALL:-${LC_CTYPE:-${LANG:-Unknown}}}
VERSION=${VAMPIRE_VERSION:-0.1.0-dev}
case "$OS" in
  *Vampire*) OS="Vampire OS x86_64" ;;
esac

# Keep the logo and information in two columns. The logo width is 24 cells.
LOGO=$(cat <<'ART'
      ██╗     ██╗
      ██║     ██║
      ██║     ██║
      ╚██╗   ██╔╝
       ╚██╗ ██╔╝
        ╚████╔╝
         ╚═══╝
    V A M P I R E
         O S
ART
)

INFO=$(printf '%s\n' \
  "$RED$WHO@vampire-os$RESET" \
  "$DIM────────────────────────────────────────$RESET" \
  "$WHITE OS:$RESET        $OS" \
  "Host:       $HOST_NAME" \
  "Kernel:     $KERNEL" \
  "Uptime:     $UPTIME" \
  "Packages:   $PACKAGES" \
  "Shell:      Vampire Shell ($SHELL_NAME)" \
  "Display:    $DISPLAY_INFO" \
  "DE:         $DE_NAME" \
  "WM:         $WM_NAME" \
  "Theme:      $THEME" \
  "Terminal:   $TERM_NAME" \
  "CPU:        $CPU" \
  "GPU:        $GPU" \
  "Memory:     $MEMORY" \
  "Local IP:   $IP" \
  "Locale:     $LOCALE")

# Add two blank logo rows so the user header begins above the system fields.
{
  printf '\n\n'
  printf '%s\n' "$LOGO"
} | paste -d '' - <(printf '%s\n' "$INFO") | while IFS= read -r line; do
  printf '%b\n' "$line"
done

printf '\n'
printf '%b●  ●  ●  ●  ●  ●%b\n' "$RED" "$RESET"
