#!/usr/bin/env bash
# Vampire Fetch - system information display. SPDX-License-Identifier: MIT
set -u
RED=$'\033[38;5;196m'
DIM=$'\033[2m'
WHITE=$'\033[97m'
RESET=$'\033[0m'
HOST=$(hostname 2>/dev/null || printf unknown)
WHO=$(id -un 2>/dev/null || printf user)
OS=Linux
if [ -r /etc/os-release ]; then OS=$(. /etc/os-release; printf '%s' "$PRETTY_NAME"); fi
KERNEL=$(uname -r 2>/dev/null || printf Unknown)
ARCH=$(uname -m 2>/dev/null || printf Unknown)
CPU=$(awk -F: '/model name/ {sub(/^[ \t]+/, "", $2); print $2; exit}' /proc/cpuinfo 2>/dev/null)
[ -n "$CPU" ] || CPU=Unknown
GPU=Not detected
if command -v lspci >/dev/null 2>&1; then
  DETECTED_GPU=$(lspci 2>/dev/null | awk -F': ' '/VGA compatible controller|3D controller|Display controller/ {print $2; exit}')
  [ -n "$DETECTED_GPU" ] && GPU=$DETECTED_GPU
fi
MEMORY=$(awk '/MemTotal:/ {t=$2} /MemAvailable:/ {a=$2} END {if(t>0) printf "%.1f GiB / %.1f GiB", (t-a)/1048576, t/1048576; else print "Unknown"}' /proc/meminfo 2>/dev/null)
UPTIME=$(uptime -p 2>/dev/null | sed 's/^up //' || true)
[ -n "$UPTIME" ] || UPTIME=Unknown
SHELL_NAME=$(basename "${SHELL:-unknown}" 2>/dev/null || printf Unknown)
TERM_NAME=${TERM:-Unknown}
DE_NAME=${XDG_CURRENT_DESKTOP:-}
[ -n "$DE_NAME" ] || DE_NAME=TTY
IP=$(hostname -I 2>/dev/null | awk '{print $1}')
[ -n "$IP" ] || IP=Not detected
PACKAGES=Unknown
if command -v apk >/dev/null 2>&1; then PACKAGES=$(apk info 2>/dev/null | wc -l | tr -d ' ')
elif command -v dpkg-query >/dev/null 2>&1; then PACKAGES=$(dpkg-query -f '.' -W 2>/dev/null | wc -c | tr -d ' ')
elif command -v rpm >/dev/null 2>&1; then PACKAGES=$(rpm -qa 2>/dev/null | wc -l | tr -d ' ')
elif command -v pacman >/dev/null 2>&1; then PACKAGES=$(pacman -Q 2>/dev/null | wc -l | tr -d ' ')
fi
EDITION=$(printenv VAMPIRE_EDITION 2>/dev/null || printf Experimental)
VERSION=$(printenv VAMPIRE_VERSION 2>/dev/null || printf 0.1.0-dev)

paste <(cat <<'LOGO'
              /\
         /\  /  \  /\
        /  \/ /\ \/  \
       /____/  V \____\
          /  /\ /\  \
     /\  /__/  V  \__\  /\
    /  \ |  []   []  | /  \
   /____\|____V______|/____\
   | []   /  / \  \   [] |
   |_____/__/___\__\______|
        V A M P I R E
             O S
LOGO
) <(printf '%s\n' \
  "$RED$WHO@$HOST$RESET" \
  "$DIM────────────────────────────────────$RESET" \
  "$WHITE OS $RESET:        $OS" \
  "Edition:   $EDITION" \
  "Version:   $VERSION" \
  "Host:      $HOST" \
  "Kernel:    $KERNEL" \
  "Arch:      $ARCH" \
  "Shell:     $SHELL_NAME" \
  "Terminal:  $TERM_NAME" \
  "DE / WM:   $DE_NAME" \
  "CPU:       $CPU" \
  "GPU:       $GPU" \
  "Memory:    $MEMORY" \
  "Packages:  $PACKAGES" \
  "Uptime:    $UPTIME" \
  "Local IP:  $IP" \
  "Rise beyond the ordinary.")
printf '\n%b  ■  ■  ■  ■  ■  ■  ■  ■%b\n' "$RED" "$RESET"
