#!/bin/sh
# Text-mode launcher for the early console image. Not the future graphical DE.
set -eu
SETTINGS=${VAMPIRE_SETTINGS_CMD:-vsettings}
FETCH=${VAMPIRE_FETCH_CMD:-vfetch}
NETWORK=${VAMPIRE_NETWORK_CMD:-vnetwork}
INSTALLER=${VAMPIRE_INSTALLER_CMD:-vinstall}
pause() { printf '\nPress Enter to continue...'; IFS= read -r _ || true; }
installer_menu() {
  printf "\nVampire Installer — read-only storage checks\n"
  printf "No partitioning or formatting is available in this build.\n\n"
  "$INSTALLER" list
  printf "\nDevice path to preflight (blank to return, e.g. /dev/sda): "
  IFS= read -r target || return
  [ -n "$target" ] && "$INSTALLER" preflight "$target" || true
  pause
}
appearance_menu() {
  while :; do
    printf '\nVampire Settings — Appearance\n'
    "$SETTINGS" list
    printf '\n1) Theme (dark/light/system)\n2) Blur preset (off/low/medium/high/extreme)\n3) Terminal opacity (0..100, steps of 10)\n4) Dock size (small/medium/large)\n5) Reduced motion (true/false)\n0) Back\nChoice: '
    IFS= read -r choice || exit 0
    case "$choice" in
      1) key=theme; printf 'Value: '; IFS= read -r value; "$SETTINGS" set "$key" "$value" ;;
      2) key=blur; printf 'Value: '; IFS= read -r value; "$SETTINGS" set "$key" "$value" ;;
      3) key=terminal_opacity; printf 'Value: '; IFS= read -r value; "$SETTINGS" set "$key" "$value" ;;
      4) key=dock_size; printf 'Value: '; IFS= read -r value; "$SETTINGS" set "$key" "$value" ;;
      5) key=reduced_motion; printf 'Value: '; IFS= read -r value; "$SETTINGS" set "$key" "$value" ;;
      0) return ;;
      *) echo "Invalid choice." ;;
    esac
  done
}
while :; do
  printf '\n  V A M P I R E  O S\n  Vampire Desktop — Console Preview\n  -------------------------------\n'
  printf '  1) System information\n  2) Appearance settings\n  3) Network status\n  4) System monitor\n  5) Open shell\n  6) Show all settings\n  7) Installer storage preflight\n  8) Graphical session (Weston preview)\n  9) VPM package manager diagnostics\n  10) Signed OS update check\n  11) Vampire Software Center (console)\n  12) SSH service status (opt-in)\n  13) Vampire Files (console)\n  0) Exit launcher\n  Select: '
  IFS= read -r choice || exit 0
  case "$choice" in
    1) "$FETCH"; pause ;;
    2) appearance_menu ;;
    3) "$NETWORK" status; pause ;;
    4) vmonitor; pause ;;
    5) "${SHELL:-/bin/sh}" ;;
    6) "$SETTINGS" list; pause ;;
    7) installer_menu ;;
    8) vgraphical; pause ;;
    9) vpm doctor; pause ;;
    10) vupdate check; pause ;;
    11) vsoftware ;;
    12) vssh status; printf "Use vssh start only after installing your trusted public key.\\n"; pause ;;
    13) vfiles ;;
    0) exit 0 ;;
    *) echo "Invalid choice." ;;
  esac
done
