#!/bin/sh
# Text-mode launcher for the early console image. Not the future graphical DE.
set -eu
SETTINGS=${VAMPIRE_SETTINGS_CMD:-vsettings}
FETCH=${VAMPIRE_FETCH_CMD:-vfetch}
NETWORK=${VAMPIRE_NETWORK_CMD:-vnetwork}
INSTALLER=${VAMPIRE_INSTALLER_CMD:-vinstall}
pause() { printf '\nPress Enter to continue...'; IFS= read -r _ || true; }
run_tool() { if "$@"; then :; else status=$?; printf "Command failed (exit %s).\n" "$status"; fi; }
run_and_pause() { run_tool "$@"; pause; }

network_menu() {
  while :; do
    printf '\n  VAMPIRE / NETWORK SETTINGS\n'
    printf '  1) Wired and interface status\n'
    printf '  2) List wireless interfaces\n'
    printf '  3) Scan Wi-Fi networks\n'
    printf '  4) Connect to Wi-Fi\n'
    printf '  5) Wi-Fi connection status\n'
    printf '  6) Disconnect Wi-Fi\n'
    printf '  0) Back\n'
    printf '  Select: '
    IFS= read -r network_choice || return 0
    case "$network_choice" in
      1) run_and_pause "$NETWORK" status ;;
      2) run_and_pause "$NETWORK" wifi list ;;
      3)
        printf 'Wireless interface (blank = first): '; IFS= read -r wifi_iface
        run_and_pause "$NETWORK" wifi scan "$wifi_iface" ;;
      4)
        printf 'Wireless interface (blank = first): '; IFS= read -r wifi_iface
        printf 'Network SSID: '; IFS= read -r wifi_ssid
        run_tool "$NETWORK" wifi connect "$wifi_iface" "$wifi_ssid"
        pause ;;
      5)
        printf 'Wireless interface (blank = first): '; IFS= read -r wifi_iface
        run_and_pause "$NETWORK" wifi status "$wifi_iface" ;;
      6)
        printf 'Wireless interface (blank = first): '; IFS= read -r wifi_iface
        run_and_pause "$NETWORK" wifi disconnect "$wifi_iface" ;;
      0) return 0 ;;
      *) echo "Invalid choice." ;;
    esac
  done
}

installer_menu() {
  printf "\nVampire Installer — read-only storage checks\n"
  printf "No partitioning or formatting is available in this build.\n\n"
  run_tool "$INSTALLER" system-check
  printf "\nDetected storage devices:\n"
  run_tool "$INSTALLER" list
  printf "\nDevice path to preflight (blank to return, e.g. /dev/sda): "
  IFS= read -r target || return
  [ -n "$target" ] && "$INSTALLER" preflight "$target" || true
  pause
}
appearance_menu() {
  while :; do
    printf '\nVampire Settings — Appearance and Desktop\n'
    run_tool "$SETTINGS" list
    printf '\n 1) Theme (dark/light/system)\n 2) Accent (crimson/rose/ice/violet)\n 3) Surface transparency (0..60)\n 4) Blur (off/low/medium/high/extreme)\n 5) Terminal opacity (0..100)\n 6) Dock size (small/medium/large)\n 7) Dock position (bottom-center/left-center/right-center)\n 8) Dock auto-hide (true/false)\n 9) Dock magnification (true/false)\n10) Top panel (true/false)\n11) Show date (true/false)\n12) Show clock (true/false)\n13) Show network (true/false)\n14) Show power (true/false)\n15) Reduced motion (true/false)\n16) Update channel (stable/testing)\n17) Voice access (true/false)\n 0) Back\nChoice: '
    IFS= read -r choice || exit 0
    case "$choice" in
      1) key=theme ;;
      2) key=accent ;;
      3) key=surface_transparency ;;
      4) key=blur ;;
      5) key=terminal_opacity ;;
      6) key=dock_size ;;
      7) key=dock_position ;;
      8) key=dock_auto_hide ;;
      9) key=dock_magnification ;;
      10) key=top_panel ;;
      11) key=show_date ;;
      12) key=show_clock ;;
      13) key=show_network ;;
      14) key=show_power ;;
      15) key=reduced_motion ;;
      16) key=update_channel ;;
      17) key=voice_access ;;
      0) return ;;
      *) echo "Invalid choice."; continue ;;
    esac
    printf 'New value for %s: ' "$key"
    IFS= read -r value || return
    if "$SETTINGS" set "$key" "$value"; then
      case "$key" in
        theme|accent|surface_transparency|terminal_opacity|top_panel|reduced_motion)
          run_tool "$SETTINGS" apply
          ;;
      esac
    fi
  done
}
case "${1:-}" in
  --settings) appearance_menu; exit 0 ;;
  --help|-h) echo "Usage: vdesktop [--settings]"; exit 0 ;;
  "") ;;
  *) echo "Usage: vdesktop [--settings]" >&2; exit 2 ;;
esac
while :; do
  printf '\n  V A M P I R E  O S\n  Vampire Desktop — Console Preview\n  -------------------------------\n'
  printf '  1) System information\n  2) Appearance and desktop settings\n  3) Network settings\n  4) System monitor\n  5) Open Vampire Shell\n  6) Show all settings\n  7) Installer storage preflight\n  8) Graphical session (Weston preview)\n  9) VPM package manager diagnostics\n  10) Signed OS update check\n  11) Vampire Software Center (console)\n  12) SSH service status (opt-in)\n  13) Vampire Files (console)\n  14) Hardware inventory\n  15) System health check\n  16) Generate support snapshot\n  17) Firewall status (read-only)\n  18) Command reference\n  19) Recent system logs\n  20) Follow live logs\n  0) Exit launcher\n  Select: '
  IFS= read -r choice || exit 0
  case "$choice" in
    1) run_and_pause "$FETCH" ;;
    2) run_tool appearance_menu ;;
    3) run_tool network_menu ;;
    4) run_and_pause vmonitor ;;
    5) if command -v vsh >/dev/null 2>&1; then run_tool vsh; else run_tool "${SHELL:-/bin/sh}"; fi ;;
    6) run_and_pause "$SETTINGS" list ;;
    7) run_tool installer_menu ;;
    8) run_and_pause vgraphical ;;
    9) run_and_pause vpm doctor ;;
    10) run_and_pause vupdate check ;;
    11) run_tool vsoftware ;;
    12) run_tool vssh status; printf "Use vssh start only after installing your trusted public key.\n"; pause ;;
    13) run_tool vfiles ;;
    14) run_and_pause vhardware ;;
    15) run_and_pause vhealth ;;
    16) run_and_pause vdiagnose --save ;;
    17) run_and_pause vfirewall status ;;
    18) run_and_pause vhelp ;;\n    19) run_and_pause vlogs --lines 100 ;;\n    20) run_and_pause vlogs --follow ;;
    0) exit 0 ;;
    *) echo "Invalid choice." ;;
  esac
done
