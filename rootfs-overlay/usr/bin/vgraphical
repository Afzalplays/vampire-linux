#!/bin/sh
# Launch and diagnose the configured Weston DRM desktop session.
set -eu

CONFIG=${VAMPIRE_WESTON_RUNTIME_CONFIG:-/run/vampire/weston.ini}
BASE_CONFIG=${VAMPIRE_WESTON_BASE:-/etc/xdg/weston/weston.ini}
FOOT_CONFIG=${VAMPIRE_FOOT_BASE:-/etc/xdg/foot/foot.ini}
DRM_DIR=${VAMPIRE_DRM_DIR:-/dev/dri}
RUNTIME_BASE=${VAMPIRE_RUNTIME_BASE:-/run/user}

error() { printf 'Vampire Desktop: %s\n' "$*" >&2; }
require_file() {
  [ ! -L "$1" ] && [ -f "$1" ] && [ -r "$1" ] || { error "required configuration is missing or unsafe: $1"; return 1; }
}
check() {
  command -v weston >/dev/null 2>&1 || { error "Weston is not installed."; return 1; }
  command -v foot >/dev/null 2>&1 || { error "Foot terminal is not installed."; return 1; }
  require_file "$BASE_CONFIG" || return 1
  require_file "$FOOT_CONFIG" || return 1
  session_uid=$(id -u)
  session_runtime="$RUNTIME_BASE/$session_uid"
  [ ! -L "$RUNTIME_BASE" ] && [ ! -L "$session_runtime" ] || {
    error "refusing symlinked session runtime path: $session_runtime"
    return 1
  }
  [ -d "$session_runtime" ] && [ "$(stat -c %u "$session_runtime" 2>/dev/null || echo -1)" = "$session_uid" ] || {
    error "private session runtime $session_runtime is missing or has the wrong owner; check boot session-runtime setup."
    return 1
  }
  [ "$(stat -c %a "$session_runtime" 2>/dev/null || echo 000)" = 700 ] || {
    error "session runtime $session_runtime must have mode 0700."
    return 1
  }
  [ -d "$DRM_DIR" ] || { error "no $DRM_DIR directory; enable a kernel DRM/KMS driver and firmware."; return 1; }
  found=
  for card in "$DRM_DIR"/card*; do
    [ -L "$card" ] && continue
    [ -c "$card" ] || continue
    found=$card
    break
  done
  [ -n "$found" ] || { error "no DRM card device found under $DRM_DIR."; return 1; }
  [ -r "$found" ] && [ -w "$found" ] || {
    error "DRM device $found is not accessible; check seat permissions."; return 1;
  }
  if [ "$session_uid" -ne 0 ]; then
    [ -n "${HOME:-}" ] && [ -d "$HOME" ] && [ -w "$HOME" ] || {
      error "a writable home directory is required for a non-root desktop session."
      return 1
    }
  fi
  printf 'Vampire Desktop preflight passed.\n'
  printf '  Weston: %s\n  DRM device: %s\n  Runtime: %s\n  Base config: %s\n  Terminal config: %s\n' \
    "$(command -v weston)" "$found" "$session_runtime" "$BASE_CONFIG" "$FOOT_CONFIG"
}

case "${1:-}" in
  --check)
    [ "$#" -eq 1 ] || { error 'usage: vgraphical [--check]'; exit 2; }
    check
    exit
    ;;
  --help|-h)
    echo "Usage: vgraphical [--check]"
    echo "  --check  Validate Weston, Foot, configuration and DRM availability."
    exit 0
    ;;
  "") ;;
  *) error 'usage: vgraphical [--check]'; exit 2 ;;
esac

if command -v modprobe >/dev/null 2>&1; then
  # Probe common in-tree DRM modules before checking for a DRM card.
  for module in i915 amdgpu nouveau virtio_gpu; do modprobe "$module" 2>/dev/null || true; done
fi
check
uid=$(id -u)
if [ "$uid" -eq 0 ]; then
  export XDG_RUNTIME_DIR="$RUNTIME_BASE/0"
  export XDG_CONFIG_HOME=/run/vampire
  export VAMPIRE_SETTINGS_FILE=/etc/vampire/settings.conf
  mkdir -p "$XDG_RUNTIME_DIR" "$XDG_CONFIG_HOME"
  chmod 0700 "$XDG_RUNTIME_DIR" "$XDG_CONFIG_HOME"
else
  home=${HOME:-}
  [ -n "$home" ] && [ -d "$home" ] && [ -w "$home" ] || {
    error "a writable home directory is required for a non-root desktop session."
    exit 1
  }
  export XDG_RUNTIME_DIR="$RUNTIME_BASE/$uid"
  [ ! -L "$RUNTIME_BASE" ] && [ ! -L "$XDG_RUNTIME_DIR" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ "$(stat -c %u "$XDG_RUNTIME_DIR" 2>/dev/null || echo -1)" = "$uid" ] || {
    error "runtime directory $XDG_RUNTIME_DIR is missing or not owned by this user; log in locally after boot."
    exit 1
  }
  [ "$(stat -c %a "$XDG_RUNTIME_DIR" 2>/dev/null || echo 000)" = 700 ] || {
    error "runtime directory must have mode 0700."
    exit 1
  }
  export XDG_CONFIG_HOME="$home/.config"
  export VAMPIRE_SETTINGS_FILE="$XDG_CONFIG_HOME/vampire/settings.conf"
  mkdir -p "$XDG_CONFIG_HOME/vampire" "$XDG_RUNTIME_DIR/vampire"
  chmod 0700 "$XDG_CONFIG_HOME/vampire" "$XDG_RUNTIME_DIR/vampire"
fi
export VAMPIRE_WESTON_RUNTIME_CONFIG="$XDG_RUNTIME_DIR/vampire/weston.ini"
if [ ! -s "$VAMPIRE_SETTINGS_FILE" ]; then
  vsettings reset
fi
vsettings apply
CONFIG=$VAMPIRE_WESTON_RUNTIME_CONFIG
[ -r "$CONFIG" ] || { error "generated Weston configuration is missing: $CONFIG"; exit 1; }
exec weston --config="$CONFIG" --backend=drm-backend.so --shell=desktop-shell.so --tty=2 "$@"
