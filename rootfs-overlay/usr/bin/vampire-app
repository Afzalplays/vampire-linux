#!/bin/sh
# Open Vampire OS console applications in the Wayland terminal.
set -eu
command -v foot >/dev/null 2>&1 || {
  echo "Vampire Desktop: Foot terminal is not installed." >&2
  exit 127
}
[ "$#" -ge 1 ] || { echo "Usage: vampire-app {files|settings|software|monitor}" >&2; exit 2; }
case "$1" in
  files) shift; exec foot /usr/bin/vfiles "$@" ;;
  settings) shift; exec foot /usr/bin/vdesktop "$@" ;;
  software) shift; exec foot /usr/bin/vsoftware "$@" ;;
  monitor) shift; exec foot /usr/bin/vmonitor "$@" ;;
  *) echo "Vampire Desktop: unknown app: $1" >&2; exit 2 ;;
esac
