#!/bin/sh
# Read-only Vampire system monitor with optional live refresh.
set -eu
PROC_ROOT=${VAMPIRE_PROC_ROOT:-/proc}
SYS_ROOT=${VAMPIRE_SYS_ROOT:-/sys}
usage() { echo "Usage: vmonitor [--once|--watch [SECONDS]]" >&2; exit 2; }
mode=once interval=2
case "${1:-}" in
  "") [ "$#" -eq 0 ] || usage ;;
  --once) [ "$#" -eq 1 ] || usage ;;
  --watch)
    mode=watch
    [ "$#" -le 2 ] || usage
    if [ "$#" -eq 2 ]; then
      case "$2" in ''|*[!0-9]*) usage ;; esac
      [ "$2" -ge 1 ] && [ "$2" -le 60 ] || usage
      interval=$2
    fi
    ;;
  --help|-h) usage ;;
  *) usage ;;
esac
render() {
  printf '\n  VAMPIRE MONITOR\n  ===============\n'
  printf '  Host:   %s\n' "$(hostname 2>/dev/null || echo unknown)"
  printf '  Kernel: %s\n' "$(uname -r 2>/dev/null || echo unknown)"
  if [ -r "$PROC_ROOT/uptime" ]; then
    awk '{ s=int($1); d=int(s/86400); h=int((s%86400)/3600); m=int((s%3600)/60); printf "  Uptime: %dd %02dh %02dm\n", d,h,m }' "$PROC_ROOT/uptime"
  else printf '  Uptime: unavailable\n'; fi
  if [ -r "$PROC_ROOT/loadavg" ]; then
    awk '{ printf "  Load:   %s %s %s\n", $1,$2,$3 }' "$PROC_ROOT/loadavg"
  else printf '  Load:   unavailable\n'; fi
  if [ -r "$PROC_ROOT/meminfo" ]; then
    awk '
      /^MemTotal:/ { total=$2 }
      /^MemAvailable:/ { available=$2; have_available=1 }
      /^MemFree:/ { free=$2 }
      /^Buffers:/ { buffers=$2 }
      /^Cached:/ { cached=$2 }
      END {
        if (total > 0) {
          if (!have_available) available=free+buffers+cached
          if (available < 0) available=0
          if (available > total) available=total
          used=total-available
          printf "  Memory: %d MiB used / %d MiB total (%d%%)\n", used/1024, total/1024, used*100/total
          printf "  Available memory: %d MiB\n", available/1024
        } else print "  Memory: unavailable"
      }' "$PROC_ROOT/meminfo"
  else printf '  Memory: unavailable\n'; fi
  thermal_found=0
  for sensor in "$SYS_ROOT"/class/thermal/thermal_zone*/temp; do
    [ -r "$sensor" ] || continue
    temp=$(cat "$sensor" 2>/dev/null || true)
    case "$temp" in ''|*[!0-9-]*) continue ;; esac
    label=$(basename "$(dirname "$sensor")")
    awk -v label="$label" -v raw="$temp" 'BEGIN { if (raw > 1000 || raw < -1000) printf "  Temperature (%s): %.1f C\n",label,raw/1000; else printf "  Temperature (%s): %s C\n",label,raw }'
    thermal_found=1
  done
  [ "$thermal_found" -eq 1 ] || printf '  Temperature: unavailable\n'
  if command -v df >/dev/null 2>&1; then
    printf '\n  Root filesystem:\n'
    df -h "$ROOT_MOUNT" 2>/dev/null | awk 'NR==1 || NR==2 { print "  " $0 }'
  fi
  printf '\n  Network:\n'
  if command -v ip >/dev/null 2>&1; then
    ip -brief addr 2>/dev/null || true
  elif command -v ifconfig >/dev/null 2>&1; then
    ifconfig 2>/dev/null || true
  else echo "  Network tools unavailable"; fi
}
ROOT_MOUNT=${VAMPIRE_ROOT_MOUNT:-/}
if [ "$mode" = once ]; then render; else
  while :; do
    printf '\033[H\033[2J'
    render
    sleep "$interval"
  done
fi
