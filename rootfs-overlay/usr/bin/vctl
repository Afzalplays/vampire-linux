#!/bin/sh
set -u
DIR=${VAMPIRE_SERVICE_DIR:-/etc/vampire/services.d}
ENABLED=${VAMPIRE_ENABLED_FILE:-/etc/vampire/services.enabled}
usage() { echo "Usage: vctl {list|start|stop|restart|status|status-all|enable|disable} SERVICE | {start-all|stop-all}" >&2; exit 2; }
valid_name() { case "$1" in ''|[!A-Za-z0-9_]*|*[!A-Za-z0-9_.-]*) return 1 ;; *) return 0 ;; esac; }
service_path() {
  valid_name "$1" || { echo "vctl: invalid service name: $1" >&2; return 2; }
  [ -f "$DIR/$1" ] && [ -x "$DIR/$1" ] || { echo "vctl: service not found: $1" >&2; return 1; }
}
run_service() { svc_name=$1 svc_action=$2; service_path "$svc_name" || return $?; "$DIR/$svc_name" "$svc_action"; }
is_enabled() { [ -f "$ENABLED" ] && grep -Fxq "$1" "$ENABLED"; }
set_enabled() {
  name=$1 mode=$2
  service_path "$name" || return $?
  parent=${ENABLED%/*}; [ "$parent" = "$ENABLED" ] && parent=.
  mkdir -p "$parent" || return 1
  old_umask=$(umask); umask 077
  tmp=$(mktemp "$ENABLED.tmp.XXXXXX") || { umask "$old_umask"; return 1; }
  if [ -f "$ENABLED" ]; then
    while IFS= read -r item || [ -n "$item" ]; do
      [ -n "$item" ] || continue
      valid_name "$item" || { echo "vctl: refusing malformed enabled entry" >&2; rm -f "$tmp"; umask "$old_umask"; return 1; }
      [ "$item" = "$name" ] && continue
      grep -Fxq "$item" "$tmp" || printf '%s\n' "$item" >> "$tmp" || { rm -f "$tmp"; umask "$old_umask"; return 1; }
    done < "$ENABLED"
  fi
  if [ "$mode" = enable ]; then
    grep -Fxq "$name" "$tmp" || printf '%s\n' "$name" >> "$tmp" || { rm -f "$tmp"; umask "$old_umask"; return 1; }
  fi
  if ! mv -f "$tmp" "$ENABLED"; then rm -f "$tmp"; umask "$old_umask"; return 1; fi
  umask "$old_umask"
  printf 'vctl: %s %s at boot\n' "$name" "${mode}d"
}
[ "$#" -ge 1 ] || usage
action=$1
case "$action" in
  list)
    [ "$#" -eq 1 ] || usage
    found=0
    for service in "$DIR"/*; do
      [ -f "$service" ] && [ -x "$service" ] || continue
      found=1; name=${service##*/}
      if is_enabled "$name"; then printf '* %s (enabled)\n' "$name"; else printf '  %s (disabled)\n' "$name"; fi
    done
    [ "$found" -eq 1 ] || echo "vctl: no services installed"
    exit 0 ;;
  status-all)
    [ "$#" -eq 1 ] || usage
    [ -f "$ENABLED" ] || exit 0
    result=0
    seen_file=$(mktemp "${TMPDIR:-/tmp}/vctl-status-seen.XXXXXX") || exit 1
    while IFS= read -r name || [ -n "$name" ]; do
      [ -n "$name" ] || continue
      if ! valid_name "$name"; then
        echo "vctl: ignoring invalid service entry" >&2
        result=1
        continue
      fi
      if grep -Fxq "$name" "$seen_file"; then
        echo "vctl: ignoring duplicate service entry: $name" >&2
        continue
      fi
      printf '%s\n' "$name" >> "$seen_file"
      run_service "$name" status || result=1
    done < "$ENABLED"
    rm -f "$seen_file"
    exit "$result" ;;
  start-all|stop-all)
    [ "$#" -eq 1 ] || usage
    [ -f "$ENABLED" ] || exit 0
    result=0; order_file=$ENABLED
    seen_file=$(mktemp "${TMPDIR:-/tmp}/vctl-seen.XXXXXX") || exit 1
    if [ "$action" = stop-all ]; then
      order_file=$(mktemp "${TMPDIR:-/tmp}/vctl-stop-order.XXXXXX") || { rm -f "$seen_file"; exit 1; }
      sed '1!G;h;$!d' "$ENABLED" > "$order_file" || { rm -f "$seen_file" "$order_file"; exit 1; }
    fi
    while IFS= read -r name || [ -n "$name" ]; do
      [ -n "$name" ] || continue
      valid_name "$name" || { echo "vctl: ignoring invalid service entry" >&2; result=1; continue; }
      if grep -Fxq "$name" "$seen_file"; then echo "vctl: ignoring duplicate service entry: $name" >&2; continue; fi
      printf '%s\n' "$name" >> "$seen_file"
      if [ "$action" = start-all ]; then run_service "$name" start || result=1
      else run_service "$name" stop || result=1
      fi
    done < "$order_file"
    rm -f "$seen_file"
    [ "$order_file" = "$ENABLED" ] || rm -f "$order_file"
    exit "$result" ;;
  enable|disable) [ "$#" -eq 2 ] || usage; set_enabled "$2" "$action"; exit $? ;;
  start|stop|restart|status)
    [ "$#" -eq 2 ] || usage
    if [ "$action" = restart ]; then
      run_service "$2" stop || { echo "vctl: restart aborted because stop failed" >&2; exit 1; }
      run_service "$2" start
    else run_service "$2" "$action"
    fi
    exit $? ;;
  *) usage ;;
esac
