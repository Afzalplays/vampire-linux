#!/bin/sh
# Vampire service dispatcher: /etc/vampire/services.d/<name> {start|stop|status}
set -eu
DIR=/etc/vampire/services.d
[ "$#" -ge 1 ] || { echo "Usage: vctl {start|stop|restart|status|list} SERVICE" >&2; exit 2; }
action=$1
case "$action" in start|stop|restart|status|list) ;; *) exit 2 ;; esac
if [ "$action" = list ]; then
  for service in "$DIR"/*; do [ -x "$service" ] && basename "$service"; done
  exit 0
fi
[ "$#" -eq 2 ] || { echo "Usage: vctl $action SERVICE" >&2; exit 2; }
name=$2
case "$name" in ''|*[!A-Za-z0-9_.-]*) echo "vctl: invalid service name" >&2; exit 2 ;; esac
service="$DIR/$name"
[ -x "$service" ] || { echo "vctl: service not found: $name" >&2; exit 1; }
if [ "$action" = restart ]; then "$service" stop || true; action=start; fi
exec "$service" "$action"
