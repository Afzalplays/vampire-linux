#!/bin/sh
# Vampire OS DHCP and Wi-Fi network manager.
set -eu
SYS_NET=${VAMPIRE_SYS_NET:-/sys/class/net}
PROC_ROOT=${VAMPIRE_PROC_ROOT:-/proc}
RUN_DIR=${VAMPIRE_NETWORK_RUN_DIR:-/run/vampire/dhcp}
WIFI_RUN_DIR=${VAMPIRE_WIFI_RUN_DIR:-/run/vampire/wifi}
WIFI_CONFIG_DIR=${VAMPIRE_WIFI_CONFIG_DIR:-/etc/vampire}
WPA_CTRL_DIR=${VAMPIRE_WPA_CTRL_DIR:-/run/wpa_supplicant}
HOOK=${VAMPIRE_DHCP_HOOK:-/usr/lib/vampire/udhcpc.script}
usage() {
  echo "Usage: vnetwork {start|stop|restart|status} [IFACE] | wifi {list|scan|status|connect|disconnect} [IFACE] [SSID]" >&2
  exit 2
}
valid_iface() {
  case "$1" in ''|*[!A-Za-z0-9_.-]*) return 1 ;; esac
  [ "${#1}" -le 15 ]
}
find_iface() {
  for path in "$SYS_NET"/*; do
    [ -e "$path" ] || continue
    candidate=${path##*/}
    [ "$candidate" = lo ] && continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}
get_iface() {
  if [ -n "$2" ]; then iface=$2; else iface=$(find_iface) || {
    echo "vnetwork: no network interface found" >&2; return 1;
  }; fi
  valid_iface "$iface" || { echo "vnetwork: invalid interface name" >&2; return 2; }
  [ -e "$SYS_NET/$iface" ] || { echo "vnetwork: interface does not exist: $iface" >&2; return 1; }
}
pidfile_for() { printf '%s/%s.pid' "$RUN_DIR" "$iface"; }
is_running() {
  pidfile=$(pidfile_for)
  [ -s "$pidfile" ] || return 1
  IFS= read -r pid < "$pidfile" || return 1
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  [ -r "$PROC_ROOT/$pid/cmdline" ] || return 1
  process_cmdline=$(tr '\000' ' ' < "$PROC_ROOT/$pid/cmdline" 2>/dev/null) || return 1
  case "$process_cmdline" in *udhcpc*) return 0 ;; *) return 1 ;; esac
}
start_network() {
  command -v udhcpc >/dev/null 2>&1 || { echo "vnetwork: udhcpc is not installed" >&2; return 127; }
  [ -x "$HOOK" ] || { echo "vnetwork: DHCP hook is missing or not executable: $HOOK" >&2; return 1; }
  mkdir -p "$RUN_DIR"
  if is_running; then echo "vnetwork: DHCP already running on $iface"; return 0; fi
  rm -f "$(pidfile_for)"
  echo "vnetwork: requesting DHCP lease on $iface"
  udhcpc -R -b -i "$iface" -s "$HOOK" -p "$(pidfile_for)"
}
stop_network() {
  pidfile=$(pidfile_for)
  if is_running; then
    IFS= read -r pid < "$pidfile"
    kill -TERM "$pid" 2>/dev/null || true
    echo "vnetwork: DHCP stopped on $iface"
  else
    echo "vnetwork: DHCP was not running on $iface"
  fi
  interface="$iface" "$HOOK" deconfig || true
  rm -f "$pidfile"
}
status_network() {
  if command -v ip >/dev/null 2>&1; then ip addr show dev "$iface"
  elif command -v ifconfig >/dev/null 2>&1; then ifconfig "$iface"
  else echo "vnetwork: neither ip nor ifconfig is available" >&2; return 1; fi
  if is_running; then echo "DHCP client: running"; else echo "DHCP client: stopped"; fi
}
wifi_list() {
  command -v iw >/dev/null 2>&1 || { echo "vnetwork: iw is not installed" >&2; return 127; }
  iw dev
}
wifi_scan() {
  command -v iw >/dev/null 2>&1 || { echo "vnetwork: iw is not installed" >&2; return 127; }
  if command -v ip >/dev/null 2>&1; then ip link set "$iface" up 2>/dev/null || true
  elif command -v ifconfig >/dev/null 2>&1; then ifconfig "$iface" up || true; fi
  echo "Scanning Wi-Fi networks on $iface..."
  iw dev "$iface" scan | awk '
    /^BSS / { if (ssid != "") printf "%-32s %s\n", ssid, signal; ssid=""; signal="signal unknown" }
    /signal:/ { signal=$2 " dBm" }
    /SSID: / { sub(/^[[:space:]]*SSID: /, ""); ssid=$0 }
    END { if (ssid != "") printf "%-32s %s\n", ssid, signal }
  '
}
wifi_status() {
  command -v wpa_cli >/dev/null 2>&1 || { echo "vnetwork: wpa_cli is not installed" >&2; return 127; }
  wpa_cli -i "$iface" status
  if is_running; then echo "DHCP client: running"; else echo "DHCP client: stopped"; fi
}
wifi_connect() {
  ssid=$1
  [ -n "$ssid" ] || { echo "Usage: vnetwork wifi connect IFACE SSID" >&2; return 2; }
  [ "${#ssid}" -le 32 ] || { echo "vnetwork: SSID must be 1–32 characters" >&2; return 2; }
  case "$ssid" in -*|*[![:print:]]*) echo "vnetwork: invalid SSID" >&2; return 2 ;; esac
  for tool in iw wpa_cli wpa_passphrase wpa_supplicant udhcpc; do
    command -v "$tool" >/dev/null 2>&1 || { echo "vnetwork: required Wi-Fi tool missing: $tool" >&2; return 127; }
  done
  printf 'Wi-Fi passphrase: '
  if [ -t 0 ] && command -v stty >/dev/null 2>&1; then
    stty -echo
    trap 'stty echo 2>/dev/null || true' INT TERM EXIT
    IFS= read -r passphrase || passphrase=
    stty echo
    trap - INT TERM EXIT
    printf '\n'
  else
    IFS= read -r passphrase || passphrase=
  fi
  length=${#passphrase}
  [ "$length" -ge 8 ] && [ "$length" -le 63 ] || {
    unset passphrase
    echo "vnetwork: WPA passphrases must contain 8–63 characters" >&2
    return 2
  }
  mkdir -p "$WIFI_CONFIG_DIR" "$WIFI_RUN_DIR" "$WPA_CTRL_DIR" "$RUN_DIR"
  config="$WIFI_CONFIG_DIR/wpa_supplicant-$iface.conf"
  network_tmp=$(mktemp "$config.network.XXXXXX")
  config_tmp=$(mktemp "$config.tmp.XXXXXX")
  trap 'rm -f "$network_tmp" "$config_tmp"' 0 HUP INT TERM
  network_block=$(printf '%s\n' "$passphrase" | wpa_passphrase "$ssid") || {
    unset passphrase
    echo "vnetwork: could not generate Wi-Fi configuration" >&2
    return 1
  }
  unset passphrase
  printf '%s\n' "$network_block" | sed '/^[[:space:]]*#/d' > "$network_tmp"
  unset network_block
  grep -q '^[[:space:]]*psk=' "$network_tmp" || {
    echo "vnetwork: wpa_passphrase did not create a PSK" >&2
    return 1
  }
  {
    printf 'ctrl_interface=DIR=$WPA_CTRL_DIR GROUP=0\nupdate_config=1\n'
    cat "$network_tmp"
  } > "$config_tmp"
  chmod 600 "$config_tmp"
  mv -f "$config_tmp" "$config"
  rm -f "$network_tmp"
  if wpa_cli -i "$iface" ping >/dev/null 2>&1; then
    wpa_cli -i "$iface" terminate >/dev/null 2>&1 || true
  fi
  echo "vnetwork: connecting to '$ssid' on $iface..."
  wpa_supplicant -B -i "$iface" -c "$config" -P "$WIFI_RUN_DIR/$iface.pid"
  count=0
  connected=false
  while [ "$count" -lt 20 ]; do
    if wpa_cli -i "$iface" status 2>/dev/null | grep -q 'wpa_state=COMPLETED'; then connected=true; break; fi
    sleep 1
    count=$((count + 1))
  done
  if [ "$connected" != true ]; then
    echo "vnetwork: Wi-Fi association timed out; inspect wpa_supplicant logs" >&2
    return 1
  fi
  trap - 0 HUP INT TERM
  start_network
}
wifi_disconnect() {
  stop_network
  wifi_pidfile="$WIFI_RUN_DIR/$iface.pid"
  if command -v wpa_cli >/dev/null 2>&1; then wpa_cli -i "$iface" terminate >/dev/null 2>&1 || true; fi
  if [ -s "$wifi_pidfile" ]; then
    IFS= read -r pid < "$wifi_pidfile" || true
    case "$pid" in
      ''|*[!0-9]*) ;;
      *)
        if kill -0 "$pid" 2>/dev/null && [ -r "$PROC_ROOT/$pid/cmdline" ]; then
          cmdline=$(tr '\000' ' ' < "$PROC_ROOT/$pid/cmdline" 2>/dev/null || true)
          case "$cmdline" in *wpa_supplicant*) kill -TERM "$pid" 2>/dev/null || true ;; esac
        fi ;;
    esac
  fi
  rm -f "$wifi_pidfile"
  echo "vnetwork: Wi-Fi disconnected on $iface"
}
wifi_command() {
  subcommand=${2:-list}
  case "$subcommand" in
    list) [ "$#" -le 2 ] || usage; wifi_list ;;
    scan|status|disconnect)
      [ "$#" -eq 3 ] || usage
      get_iface "$subcommand" "$3"
      case "$subcommand" in
        scan) wifi_scan ;;
        status) wifi_status ;;
        disconnect) wifi_disconnect ;;
      esac ;;
    connect)
      [ "$#" -eq 4 ] || usage
      get_iface "$subcommand" "$3"
      wifi_connect "$4" ;;
    *) usage ;;
  esac
}
[ "$#" -le 4 ] || usage
if [ "${1:-}" = wifi ]; then wifi_command "$@"; exit $?; fi
action=${1:-help}
case "$action" in
  start|stop|restart|status)
    [ "$#" -le 2 ] || usage
    get_iface "$action" "${2:-}"
    case "$action" in
      start) start_network ;;
      stop) stop_network ;;
      restart) stop_network; start_network ;;
      status) status_network ;;
    esac ;;
  help|-h|--help) usage ;;
  *) usage ;;
esac
