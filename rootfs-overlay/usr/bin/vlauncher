#!/bin/sh
# Vampire Launcher — searchable application catalog and tested app dispatcher.
set -eu
APP=${VAMPIRE_APP_CMD:-/usr/bin/vampire-app}
TERMINAL=${VAMPIRE_TERMINAL_CMD:-/usr/bin/vampire-terminal}
usage() {
  printf 'Usage: vlauncher [--list|--json|--search TEXT|--launch APP-ID|--help]\n'
}
catalog() {
  printf '%s\n' \
    'terminal|Terminal|Open Vampire Terminal' \
    'files|Files|Browse and manage files' \
    'settings|Settings|Configure appearance and desktop preferences' \
    'software|Software Center|Search, install and remove VPM packages' \
    'monitor|System Monitor|View CPU, memory, thermal and network status'
}
json_catalog() {
  printf '%s\\n' '[{"id":"terminal","name":"Terminal","description":"Open Vampire Terminal","category":"system"},{"id":"files","name":"Files","description":"Browse and manage files","category":"utilities"},{"id":"settings","name":"Settings","description":"Configure appearance and desktop preferences","category":"system"},{"id":"software","name":"Software Center","description":"Search, install and remove VPM packages","category":"system"},{"id":"monitor","name":"System Monitor","description":"View CPU, memory, thermal and network status","category":"utilities"}]'
}
launch_app() {
  case "$1" in
    terminal) "$TERMINAL" ;;
    files|settings|software|monitor) "$APP" "$1" ;;
    *) printf 'Vampire Launcher: unknown application ID: %s\n' "$1" >&2; return 1 ;;
  esac
}
case "${1:-}" in
  --help|-h) usage; exit 0 ;;
  --json)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    json_catalog
    exit 0
    ;;
  --list)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    catalog
    exit 0
    ;;
  --search)
    [ "$#" -eq 2 ] || { usage >&2; exit 2; }
    catalog | grep -iF -- "$2" || exit 1
    exit 0
    ;;
  --launch)
    [ "$#" -eq 2 ] || { usage >&2; exit 2; }
    launch_app "$2"
    exit $?
    ;;
  "") [ "$#" -eq 0 ] || { usage >&2; exit 2; } ;;
  *) usage >&2; exit 2 ;;
esac
while :; do
  printf '\n  V A M P I R E  /  LAUNCHER\n'
  printf '  Search: vlauncher --search TEXT\n'
  printf '  ------------------------------------------\n'
  catalog | while IFS='|' read -r id name description; do
    printf '  %-9s %-15s %s\n' "$id" "$name" "$description"
  done
  printf '\n  Search applications or enter an app ID/name (0 to close): '
  IFS= read -r choice || exit 0
  case "$choice" in
    0|q|quit) exit 0 ;;
    "") continue ;;
  esac
  exact=$(catalog | awk -F'|' -v query="$choice" 'tolower($1) == tolower(query) || tolower($2) == tolower(query)')
  if [ -n "$exact" ]; then
    app_id=$(printf '%s\n' "$exact" | cut -d'|' -f1)
    launch_app "$app_id"
    continue
  fi
  matches=$(catalog | grep -iF -- "$choice" || true)
  if [ -n "$matches" ]; then
    printf '\n  Matching applications:\n%s\n' "$matches"
    printf '  Enter an exact app ID or application name to launch it.\n'
  else
    printf '  No applications match: %s\n' "$choice"
  fi
done
