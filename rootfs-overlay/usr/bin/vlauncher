#!/bin/sh
# Vampire Launcher — keyboard-driven app discovery for the Weston preview.
set -eu
APP=${VAMPIRE_APP_CMD:-/usr/bin/vampire-app}
usage() { printf 'Usage: vlauncher [--search TEXT|--help]\n'; }
catalog() {
  printf '%s\n' \
    'Terminal|Open a command terminal' \
    'Files|Browse and manage files' \
    'Settings|Configure appearance and desktop preferences' \
    'Software|Search, install and remove VPM packages' \
    'Monitor|View CPU, memory, thermal and network status'
}
case "${1:-}" in
  --help|-h) usage; exit 0 ;;
  --search)
    [ "$#" -eq 2 ] || { usage >&2; exit 2; }
    catalog | grep -iF -- "$2" || exit 1
    exit 0
    ;;
  "") [ "$#" -eq 0 ] || { usage >&2; exit 2; } ;;
  *) usage >&2; exit 2 ;;
esac
while :; do
  printf '\n  V A M P I R E  /  LAUNCHER\n'
  printf '  Search: type --search TEXT from a terminal\n'
  printf '  ------------------------------------------\n'
  catalog | while IFS='|' read -r name description; do
    printf '  %-10s %s\n' "$name" "$description"
  done
  printf '\n  1) Terminal\n  2) Files\n  3) Settings\n  4) Software Center\n  5) System Monitor\n  0) Close launcher\n  Select: '
  IFS= read -r choice || exit 0
  case "$choice" in
    1) exec foot /bin/sh ;;
    2) "$APP" files ;;
    3) "$APP" settings ;;
    4) "$APP" software ;;
    5) "$APP" monitor ;;
    0) exit 0 ;;
    *) printf '  Invalid selection.\n' ;;
  esac
done
