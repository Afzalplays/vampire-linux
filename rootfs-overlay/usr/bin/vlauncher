#!/bin/sh
# Vampire Launcher — searchable application catalog and tested app dispatcher.
set -eu
APP=${VAMPIRE_APP_CMD:-/usr/bin/vampire-app}
TERMINAL=${VAMPIRE_TERMINAL_CMD:-/usr/bin/vampire-terminal}
usage() {
  printf 'Usage: vlauncher [--list|--json|--check|--search TEXT|--category system|utilities|--launch APP-ID|--help]\n'
}
catalog() {
  printf '%s\n' \
    'terminal|Terminal|Open Vampire Terminal' \
    'files|Files|Browse and manage files' \
    'settings|Settings|Configure appearance and desktop preferences' \
    'software|Software Center|Search, install and remove VPM packages' \
    'monitor|System Monitor|View CPU, memory, thermal and network status'
}
json_catalog() {
  printf '%s\n' '[{"id":"terminal","name":"Terminal","description":"Open Vampire Terminal","category":"system","icon":"/usr/share/vampire/icons/terminal.png"},{"id":"files","name":"Files","description":"Browse and manage files","category":"utilities","icon":"/usr/share/vampire/icons/files.png"},{"id":"settings","name":"Settings","description":"Configure appearance and desktop preferences","category":"system","icon":"/usr/share/vampire/icons/settings.png"},{"id":"software","name":"Software Center","description":"Search, install and remove VPM packages","category":"system","icon":"/usr/share/vampire/icons/software.png"},{"id":"monitor","name":"System Monitor","description":"View CPU, memory, thermal and network status","category":"utilities","icon":"/usr/share/vampire/icons/monitor.png"}]'
}
launch_app() {
  case "$1" in
    terminal) "$TERMINAL" ;;
    files|settings|software|monitor) "$APP" "$1" ;;
    *) printf 'Vampire Launcher: unknown application ID: %s\n' "$1" >&2; return 1 ;;
  esac
}
check_installation() {
  ROOT=${VAMPIRE_ROOT:-}
  failed=0
  for binary in vampire-terminal vampire-app vlauncher vfiles vdesktop vsoftware vmonitor; do
    if [ ! -x "$ROOT/usr/bin/$binary" ]; then
      printf 'Missing or non-executable desktop command: /usr/bin/%s\n' "$binary" >&2
      failed=1
    fi
  done
  for icon in terminal launcher files settings software monitor; do
    if [ ! -s "$ROOT/usr/share/vampire/icons/$icon.png" ]; then
      printf 'Missing desktop application icon: /usr/share/vampire/icons/%s.png\n' "$icon" >&2
      failed=1
    fi
  done
  if [ "$failed" -ne 0 ]; then
    printf 'Vampire Launcher: desktop payload validation failed.\n' >&2
    return 1
  fi
  printf 'Vampire Launcher: all seven desktop commands and six application icons are present.\n'
}
case "${1:-}" in
  --help|-h) usage; exit 0 ;;
  --json)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    json_catalog
    exit 0
    ;;
  --list)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    catalog
    exit 0
    ;;
  --check)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    check_installation
    exit $?
    ;;
  --category)
    [ "$#" -eq 2 ] || { usage >&2; exit 2; }
    case "$2" in
      system)
        catalog | awk -F'|' '$1 == "terminal" || $1 == "settings" || $1 == "software" { print }'
        ;;
      utilities)
        catalog | awk -F'|' '$1 == "files" || $1 == "monitor" { print }'
        ;;
      *)
        printf 'Vampire Launcher: unknown category: %s\n' "$2" >&2
        exit 2
        ;;
    esac
    exit 0
    ;;
  --search)
    [ "$#" -eq 2 ] || { usage >&2; exit 2; }
    catalog | grep -iF -- "$2" || exit 1
    exit 0
    ;;
  --launch)
    [ "$#" -eq 2 ] || { usage >&2; exit 2; }
    launch_app "$2"
    exit $?
    ;;
  "") [ "$#" -eq 0 ] || { usage >&2; exit 2; } ;;
  *) usage >&2; exit 2 ;;
esac
while :; do
  printf '\n  V A M P I R E  /  LAUNCHER\n'
  printf '  Search: vlauncher --search TEXT\n'
  printf '  ------------------------------------------\n'
  catalog | while IFS='|' read -r id name description; do
    printf '  %-9s %-15s %s\n' "$id" "$name" "$description"
  done
  printf '\n  Search apps, enter an app ID/name, or type system/utilities (0 to close): '
  IFS= read -r choice || exit 0
  case "$choice" in
    0|q|quit) exit 0 ;;
    "") continue ;;
    system|utilities)
      printf '\n  %s applications:\n' "$choice"
      if [ "$choice" = system ]; then
        catalog | awk -F'|' '$1 == "terminal" || $1 == "settings" || $1 == "software" { printf "  %-9s %-15s %s\n", $1, $2, $3 }'
      else
        catalog | awk -F'|' '$1 == "files" || $1 == "monitor" { printf "  %-9s %-15s %s\n", $1, $2, $3 }'
      fi
      continue
      ;;
  esac
  exact=$(catalog | awk -F'|' -v query="$choice" 'tolower($1) == tolower(query) || tolower($2) == tolower(query)')
  if [ -n "$exact" ]; then
    app_id=$(printf '%s\n' "$exact" | cut -d'|' -f1)
    launch_app "$app_id"
    continue
  fi
  matches=$(catalog | grep -iF -- "$choice" || true)
  if [ -n "$matches" ]; then
    match_count=$(printf '%s\n' "$matches" | awk 'END { print NR }')
    if [ "$match_count" -eq 1 ]; then
      app_id=$(printf '%s\n' "$matches" | cut -d'|' -f1)
      printf '  Opening %s...\n' "$app_id"
      launch_app "$app_id"
      continue
    fi
    printf '\n  Matching applications:\n'
    printf '%s\n' "$matches" | awk -F'|' '{ printf "  %d) %s — %s\n", NR, $2, $3 }'
    printf '  Select a number (0 to cancel): '
    IFS= read -r selection || exit 0
    case "$selection" in
      ''|*[!0-9]*) echo '  Invalid selection.'; continue ;;
      0) continue ;;
    esac
    app_id=$(printf '%s\n' "$matches" | awk -F'|' -v n="$selection" 'NR == n { print $1; found=1; exit } END { if (!found) exit 1 }') || {
      echo '  Selection is outside the result list.'
      continue
    }
    launch_app "$app_id"
  else
    printf '  No applications match: %s\n' "$choice"
  fi
done
