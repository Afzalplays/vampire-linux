#!/bin/sh
# Vampire OS installer: guarded disk deployment plus read-only preflight.
set -eu
SYS_BLOCK=${VAMPIRE_SYS_BLOCK:-/sys/block}
DEV_ROOT=${VAMPIRE_DEV_ROOT:-/dev}
MOUNTS_FILE=${VAMPIRE_MOUNTS_FILE:-/proc/mounts}
MOUNTINFO_FILE=${VAMPIRE_MOUNTINFO_FILE:-/proc/self/mountinfo}
SWAPS_FILE=${VAMPIRE_SWAPS_FILE:-/proc/swaps}
MIN_SECTORS=16777216 # 8 GiB using 512-byte sectors
usage() {
  cat <<'EOF'
Vampire Installer — preflight, rootfs staging and target configuration
Usage:
  vinstall system-check
  vinstall list
  vinstall preflight /dev/DEVICE
  vinstall plan /dev/DEVICE [uefi|bios]
  vinstall install ROOTFS.tar /dev/DEVICE [uefi|bios]
  vinstall requirements
  vinstall media
  vinstall validate ROOTFS.tar
  vinstall stage ROOTFS.tar EMPTY_MOUNTPOINT
  vinstall configure ROOTDIR ROOT_UUID uefi|bios [ESP_UUID]
  vinstall help
install is destructive: it erases the selected whole disk after a typed confirmation.
It requires a verified rootfs archive, live kernel at /boot/vmlinuz and root access.
The plan command is read-only. Stage/configure only write inside an existing target.
EOF
}
disk_name() {
  case "$1" in "$DEV_ROOT"/*) name=${1#"$DEV_ROOT"/} ;; *) return 1 ;; esac
  case "$name" in ""|*/*|*[!A-Za-z0-9._-]*) return 1 ;; esac
  printf '%s\n' "$name"
}
read_attr() {
  file=$1
  if [ -r "$file" ]; then IFS= read -r value < "$file" || value=; printf '%s' "$value"
  else printf '?'; fi
}
is_partition() { [ -r "$1/partition" ]; }
canonical_device() {
  if command -v readlink >/dev/null 2>&1; then
    resolved=$(readlink -f "$1" 2>/dev/null || true)
    [ -n "$resolved" ] && { printf '%s\n' "$resolved"; return 0; }
  fi
  printf '%s\n' "$1"
}
resolve_sys_block() {
  candidate="$SYS_BLOCK/$1"
  if [ -d "$candidate" ]; then printf '%s\n' "$candidate"; return 0; fi
  for child in "$SYS_BLOCK"/*/"$1"; do
    [ -d "$child" ] || continue
    printf '%s\n' "$child"
    return 0
  done
  return 1
}
installer_requirements() {
  printf 'Vampire OS installer tool readiness (diagnostic only)\n'
  missing=0
  for tool in parted partprobe udevadm mkfs.fat mkfs.ext4 mount umount grub-install blkid tar python3 sha256sum readlink mktemp grep; do
    if command -v "$tool" >/dev/null 2>&1; then
      printf 'AVAILABLE  %s\n' "$tool"
    else
      printf 'MISSING    %s\n' "$tool"
      missing=1
    fi
  done
  if [ "$missing" -eq 0 ]; then
    printf 'All installer commands are available. A destructive installation still requires a separate exact disk confirmation.\n'
  else
    printf 'Installer execution is unavailable until every prerequisite is installed.\n'
    return 1
  fi
}

system_check() {
  printf 'Vampire OS installation environment check\n'
  arch=$(uname -m 2>/dev/null || echo unknown)
  printf 'Architecture: %s\n' "$arch"
  case "$arch" in x86_64|amd64) ;; *) echo 'BLOCKER: this image targets x86_64/AMD64.'; return 1 ;; esac
  if [ -d /sys/firmware/efi ]; then firmware=UEFI
  else firmware=Legacy-BIOS-or-unknown; fi
  printf 'Firmware: %s\n' "$firmware"
  mem_kib=$(awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null || true)
  case "$mem_kib" in ''|*[!0-9]*) echo 'WARNING: system memory could not be detected.' ;;
    *) mem_mib=$((mem_kib / 1024)); printf 'Memory: %s MiB\n' "$mem_mib"
       [ "$mem_mib" -ge 1024 ] || echo 'WARNING: less than 1 GiB RAM; installation/live use may be unreliable.' ;;
  esac
  for tool in sh awk mount; do
    if command -v "$tool" >/dev/null 2>&1; then printf 'Tool %-8s available\n' "$tool"
    else printf 'WARNING: required diagnostic tool missing: %s\n' "$tool"; fi
  done
  echo 'This command is diagnostic only; it has not changed storage.'
}
list_disks() {
  [ -d "$SYS_BLOCK" ] || { printf 'Block-device inventory unavailable.\n' >&2; return 1; }
  printf '%-18s %10s %-5s %-5s %s\n' DEVICE SIZE_MiB RO REMOVABLE MODEL
  found=0
  for path in "$SYS_BLOCK"/*; do
    [ -d "$path" ] || continue
    is_partition "$path" && continue
    name=${path##*/}
    case "$name" in loop*|ram*|zram*) continue ;; esac
    sectors=$(read_attr "$path/size")
    case "$sectors" in ''|*[!0-9]*) continue ;; esac
    mib=$((sectors / 2048))
    ro=$(read_attr "$path/ro"); removable=$(read_attr "$path/removable")
    model=$(read_attr "$path/device/model")
    printf '%-18s %10s %-5s %-5s %s\n' "$DEV_ROOT/$name" "$mib" "$ro" "$removable" "$model"
    found=1
  done
  [ "$found" -eq 1 ] || printf 'No whole-disk devices detected.\n'
}
preflight() {
  device=$1
  name=$(disk_name "$device") || { printf 'ERROR: use a direct device path below %s.\n' "$DEV_ROOT" >&2; return 2; }
  [ -e "$DEV_ROOT/$name" ] || { printf 'ERROR: device does not exist: %s\n' "$device" >&2; return 2; }
  sys=$(resolve_sys_block "$name") || { printf 'ERROR: no sysfs block-device record for %s.\n' "$device" >&2; return 2; }
  is_partition "$sys" && { printf 'ERROR: select the whole disk, not a partition: %s\n' "$device" >&2; return 2; }
  sectors=$(read_attr "$sys/size")
  case "$sectors" in ''|*[!0-9]*) printf 'ERROR: cannot read device capacity.\n' >&2; return 2 ;; esac
  ro=$(read_attr "$sys/ro"); removable=$(read_attr "$sys/removable")
  mib=$((sectors / 2048))
  printf 'Vampire Installer storage preflight: %s\n' "$device"
  printf 'Capacity: %s MiB\nRead-only: %s\nRemovable: %s\n' "$mib" "$ro" "$removable"
  ready=1
  if [ "$sectors" -lt "$MIN_SECTORS" ]; then printf 'BLOCKER: disk is smaller than the 8 GiB minimum target.\n'; ready=0; fi
  if [ "$ro" = 1 ]; then printf 'BLOCKER: kernel reports this device as read-only.\n'; ready=0; fi
  if [ "$removable" = 1 ]; then printf 'WARNING: this is marked as removable media; verify the target carefully.\n'; fi
  if [ -r "$MOUNTS_FILE" ] && [ -r "$MOUNTINFO_FILE" ] && [ -r "$SWAPS_FILE" ]; then
    target_real=$(canonical_device "$device")
    # Refuse stacked devices (LVM, RAID, dm-crypt, multipath) rather than
    # guessing whether modifying their backing disk is safe.
    for node in "$sys" "$sys"/*; do
      [ -d "$node" ] || continue
      [ "$node" = "$sys" ] || is_partition "$node" || continue
      holders="$node/holders"
      if [ -d "$holders" ]; then
        for holder in "$holders"/*; do
          [ -e "$holder" ] || continue
          printf 'BLOCKER: device is backing an active stacked block device (%s).\n' "${holder##*/}"
          ready=0
        done
      fi
      node_dev=$(read_attr "$node/dev")
      case "$node_dev" in
        ''|\?|*[!0-9:]*|:*|*:)
          printf 'BLOCKER: cannot verify active mounts for %s; sysfs major:minor is unavailable.\n' "${node##*/}"
          ready=0
          node_dev= ;;
      esac
      if [ -n "$node_dev" ]; then
        mounted_points=$(awk -v dev="$node_dev" '$3 == dev {print $5}' "$MOUNTINFO_FILE")
        if [ -n "$mounted_points" ]; then
          while IFS= read -r mountpoint; do
            [ -n "$mountpoint" ] || continue
            printf 'BLOCKER: device or partition is mounted at %s (major:minor %s).\n' "$mountpoint" "$node_dev"
            ready=0
          done <<EOF_MOUNTED
$mounted_points
EOF_MOUNTED
        fi
      fi
    done
    # Swap is not listed in mount tables; check its source explicitly.
    while IFS=' ' read -r swap_source rest; do
      [ -n "$swap_source" ] || continue
      [ "$swap_source" = Filename ] && continue
      case "$swap_source" in "$DEV_ROOT"/*)
        swap_real=$(canonical_device "$swap_source")
        if [ "$swap_real" = "$target_real" ]; then
          printf 'BLOCKER: target disk is active swap: %s\n' "$swap_source"
          ready=0
        else
          for part in "$sys"/*; do
            [ -d "$part" ] && is_partition "$part" || continue
            part_name=${part##*/}
            part_real=$(canonical_device "$DEV_ROOT/$part_name")
            if [ "$swap_real" = "$part_real" ]; then
              printf 'BLOCKER: target partition is active swap: %s\n' "$swap_source"
              ready=0
            fi
          done
        fi ;;
      esac
    done < "$SWAPS_FILE"
    for part in "$sys"/*; do
      [ -d "$part" ] && is_partition "$part" || continue
      part_name=${part##*/}
      part_real=$(canonical_device "$DEV_ROOT/$part_name")
      [ -e "$DEV_ROOT/$part_name" ] || continue
      while IFS=' ' read -r source mountpoint rest; do
        case "$source" in "$DEV_ROOT"/*)
          source_real=$(canonical_device "$source")
          if [ "$source_real" = "$target_real" ] || [ "$source_real" = "$part_real" ]; then
            printf 'BLOCKER: device or partition is mounted at %s (%s).\n' "$mountpoint" "$source"
            ready=0
          fi ;;
        esac
      done < "$MOUNTS_FILE"
    done
    while IFS=' ' read -r source mountpoint rest; do
      case "$source" in "$DEV_ROOT"/*)
        source_real=$(canonical_device "$source")
        if [ "$source_real" = "$target_real" ]; then
          printf 'BLOCKER: target disk is mounted at %s (%s).\n' "$mountpoint" "$source"
          ready=0; mounted=1
        fi ;;
      esac
    done < "$MOUNTS_FILE"
  else
    printf 'BLOCKER: mount, mountinfo or swap table unavailable; refusing to approve a disk without complete active-use checks.\n'
    ready=0
  fi
  if [ "$ready" -eq 1 ]; then
    printf 'PREFLIGHT: basic checks passed. No disk changes were made.\n'
  else
    printf 'PREFLIGHT: do not install to this device until blockers are resolved.\n'
    return 1
  fi
}

installation_plan() {
  device=$1
  mode=${2:-}
  case "$mode" in
    "") if [ -d /sys/firmware/efi ]; then mode=uefi; else mode=bios; fi ;;
    uefi|bios) ;;
    *) printf 'ERROR: firmware mode must be uefi or bios.\n' >&2; return 2 ;;
  esac
  preflight "$device" || return $?
  name=$(disk_name "$device") || return 2
  sys=$(resolve_sys_block "$name") || return 2
  sectors=$(read_attr "$sys/size")
  mib=$((sectors / 2048))
  printf '\nVampire OS proposed installation layout (READ-ONLY PLAN)\n'
  printf 'Target: %s\nFirmware: %s\nDisk capacity: %s MiB\n' "$device" "$mode" "$mib"
  if [ "$mode" = uefi ]; then
    printf 'Partition table: GPT\n'
    printf '1) 512 MiB  EFI System Partition (FAT32), mount at /boot/efi\n'
    printf '2) Remaining space  Linux filesystem (ext4), mount at /\n'
  else
    printf 'Partition table: GPT\n'
    printf '1) 2 MiB  BIOS boot partition (unformatted, GRUB bios_grub flag)\n'
    printf '2) Remaining space  Linux filesystem (ext4), mount at /\n'
  fi
  printf '\nNo partition table was written. No filesystem was created. No data was changed.\n'
  printf 'This is a read-only proposal. No partition table or filesystem was changed.\n'
}

validate_rootfs() {
  archive=$1
  [ -f "$archive" ] || { printf "ERROR: rootfs archive not found: %s\n" "$archive" >&2; return 2; }
  checksum_file="$archive.sha256"
  [ -s "$checksum_file" ] || { printf "ERROR: matching rootfs checksum is required: %s\n" "$checksum_file" >&2; return 2; }
  command -v sha256sum >/dev/null 2>&1 || { printf "ERROR: sha256sum is required\n" >&2; return 1; }
  (cd "$(dirname "$archive")" && sha256sum -c "$(basename "$checksum_file")") || { printf "ERROR: rootfs checksum verification failed\n" >&2; return 1; }
  stage_script=${VAMPIRE_ROOTFS_STAGE:-/usr/lib/vampire/stage-rootfs.py}
  [ -r "$stage_script" ] || { printf "ERROR: rootfs staging validator missing: %s\n" "$stage_script" >&2; return 1; }
  exec python3 "$stage_script" --validate-only "$archive"
}

stage_rootfs() {
  [ "$(id -u)" -eq 0 ] || { printf "ERROR: root privileges are required to stage an OS rootfs\\n" >&2; return 1; }
  archive=$1
  destination=$2
  [ -f "$archive" ] || { printf 'ERROR: rootfs archive not found: %s\n' "$archive" >&2; return 2; }
  checksum_file="$archive.sha256"
  [ -s "$checksum_file" ] || { printf 'ERROR: matching rootfs checksum is required: %s\n' "$checksum_file" >&2; return 2; }
  command -v sha256sum >/dev/null 2>&1 || { printf 'ERROR: sha256sum is required to verify the rootfs archive\n' >&2; return 1; }
  (cd "$(dirname "$archive")" && sha256sum -c "$(basename "$checksum_file")") || { printf 'ERROR: rootfs checksum verification failed\n' >&2; return 1; }
  [ -d "$destination" ] || { printf 'ERROR: destination must already be a mounted, empty directory: %s\n' "$destination" >&2; return 2; }
  stage_script=${VAMPIRE_ROOTFS_STAGE:-/usr/lib/vampire/stage-rootfs.py}
  [ -r "$stage_script" ] || { printf 'ERROR: rootfs staging validator missing: %s\n' "$stage_script" >&2; return 1; }
  exec python3 "$stage_script" "$archive" "$destination"
}
find_install_media() {
  mountpoint=/run/vampire-install-media
  mkdir -p "$mountpoint"
  if grep -q " $mountpoint " /proc/mounts 2>/dev/null; then
    if [ -s "$mountpoint/install/rootfs.tar" ] && [ -s "$mountpoint/install/rootfs.tar.sha256" ]; then
      printf '%s\n' "$mountpoint/install/rootfs.tar"
      return 0
    fi
    umount "$mountpoint" || return 1
  fi
  for candidate in /dev/sr* /dev/sd* /dev/nvme* /dev/mmcblk*; do
    [ -b "$candidate" ] || continue
    fstype=$(blkid -s TYPE -o value "$candidate" 2>/dev/null || true)
    [ "$fstype" = iso9660 ] || continue
    if mount -t iso9660 -o ro "$candidate" "$mountpoint" 2>/dev/null; then
      if [ -s "$mountpoint/install/rootfs.tar" ] && [ -s "$mountpoint/install/rootfs.tar.sha256" ]; then
        printf '%s\n' "$mountpoint/install/rootfs.tar"
        return 0
      fi
      umount "$mountpoint" || return 1
    fi
  done
  echo "ERROR: no Vampire OS installation ISO with /install/rootfs.tar was found." >&2
  return 1
}

install_system() {
  archive=$1
  device=$2
  mode=${3:-}
  [ "$(id -u)" -eq 0 ] || { echo "ERROR: installation requires root privileges." >&2; return 1; }
  case "$mode" in
    "") if [ -d /sys/firmware/efi ]; then mode=uefi; else mode=bios; fi ;;
    uefi|bios) ;;
    *) echo "ERROR: firmware mode must be uefi or bios." >&2; return 2 ;;
  esac

  # Validate every input and prerequisite before the first destructive command.
  [ -f "$archive" ] || { echo "ERROR: rootfs archive not found: $archive" >&2; return 2; }
  [ -s "$archive.sha256" ] || { echo "ERROR: rootfs checksum is missing." >&2; return 2; }
  kernel_image=${VAMPIRE_KERNEL_IMAGE:-/boot/vmlinuz}
  [ -f "$kernel_image" ] && [ ! -L "$kernel_image" ] && [ -s "$kernel_image" ] || {
    echo "ERROR: live kernel must be a non-symlink regular file with content: $kernel_image." >&2
    return 1
  }
  for tool in parted partprobe udevadm mkfs.fat mkfs.ext4 mount umount grub-install blkid tar python3 sha256sum mktemp grep; do
    command -v "$tool" >/dev/null 2>&1 || { echo "ERROR: required installer tool is missing: $tool" >&2; return 1; }
  done
  (cd "$(dirname "$archive")" && sha256sum -c "$(basename "$archive").sha256") || { echo "ERROR: rootfs checksum verification failed." >&2; return 1; }
  stage_script=${VAMPIRE_ROOTFS_STAGE:-/usr/lib/vampire/stage-rootfs.py}
  [ -r "$stage_script" ] || { echo "ERROR: rootfs staging validator missing: $stage_script" >&2; return 1; }
  configure_script=${VAMPIRE_INSTALL_CONFIGURER:-/usr/lib/vampire/configure-installed-root.py}
  [ -r "$configure_script" ] || { echo "ERROR: installed-root configurator missing: $configure_script" >&2; return 1; }
  python3 "$stage_script" --validate-only "$archive" || return 1
  preflight "$device" || return $?

  printf '\nDESTRUCTIVE INSTALLATION REVIEW\n'
  printf 'Disk: %s\nFirmware: %s\nRootfs: %s\n' "$device" "$mode" "$archive"
  if [ "$mode" = uefi ]; then
    echo "Layout: GPT, 512 MiB EFI System Partition, remaining space ext4 root."
  else
    echo "Layout: GPT, 2 MiB BIOS boot partition, remaining space ext4 root."
  fi
  printf 'WARNING: ALL DATA AND PARTITIONS ON %s WILL BE PERMANENTLY ERASED.\n' "$device"
  printf 'Type exactly ERASE %s to continue: ' "$device"
  IFS= read -r confirmation || return 1
  [ "$confirmation" = "ERASE $device" ] || { echo "Installation cancelled; disk was not changed."; return 1; }

  name=$(disk_name "$device") || return 2
  case "$name" in *[0-9]) part1="${device}p1"; part2="${device}p2" ;;
    *) part1="${device}1"; part2="${device}2" ;;
  esac
  work=$(mktemp -d /tmp/vampire-install.XXXXXX) || return 1
  mounted_root=0
  mounted_esp=0
  cleanup_install() {
    cleanup_failed=0
    if [ "$mounted_esp" -eq 1 ]; then
      if umount "$work/target/boot/efi"; then mounted_esp=0
      else echo "ERROR: could not unmount EFI partition; preserving installer mount directory." >&2; cleanup_failed=1
      fi
    fi
    if [ "$mounted_root" -eq 1 ]; then
      if umount "$work/target"; then mounted_root=0
      else echo "ERROR: could not unmount target root; preserving installer mount directory." >&2; cleanup_failed=1
      fi
    fi
    if [ "$cleanup_failed" -eq 1 ]; then
      echo "ERROR: installation cleanup is incomplete. Inspect mounts under $work before retrying." >&2
      return 1
    fi
    rm -rf "$work"
  }
  trap cleanup_install EXIT
  trap 'exit 1' HUP INT TERM

  # Recheck immediately before the first destructive operation. The target may
  # have become mounted, read-only, or active swap while the confirmation was
  # being entered; never rely solely on the earlier preflight snapshot.
  echo "Rechecking target disk immediately before partitioning ..."
  preflight "$device" || return $?

  echo "Writing GPT partition table to $device ..."
  parted -s "$device" mklabel gpt
  if [ "$mode" = uefi ]; then
    parted -s "$device" mkpart ESP fat32 1MiB 513MiB
    parted -s "$device" set 1 esp on
    parted -s "$device" mkpart primary ext4 513MiB 100%
  else
    parted -s "$device" mkpart BIOS 1MiB 3MiB
    parted -s "$device" set 1 bios_grub on
    parted -s "$device" mkpart primary ext4 3MiB 100%
  fi
  partprobe "$device"
  udevadm settle
  [ -b "$part2" ] || { echo "ERROR: root partition did not appear: $part2" >&2; return 1; }
  [ "$mode" != uefi ] || [ -b "$part1" ] || { echo "ERROR: EFI partition did not appear: $part1" >&2; return 1; }

  if [ "$mode" = uefi ]; then mkfs.fat -F 32 -n VAMPIRE_EFI "$part1"; fi
  mkfs.ext4 -F -L VAMPIRE_ROOT "$part2"
  mkdir -p "$work/target"
  mount "$part2" "$work/target"
  mounted_root=1
  python3 "$stage_script" "$archive" "$work/target"
  mkdir -p "$work/target/boot"
  cp "${VAMPIRE_KERNEL_IMAGE:-/boot/vmlinuz}" "$work/target/boot/vmlinuz"
  chmod 0644 "$work/target/boot/vmlinuz"
  root_uuid=$(blkid -s UUID -o value "$part2")
  [ -n "$root_uuid" ] || { echo "ERROR: unable to read root filesystem UUID." >&2; return 1; }
  root_partuuid=$(blkid -s PARTUUID -o value "$part2")
  [ -n "$root_partuuid" ] || { echo "ERROR: unable to read root partition PARTUUID." >&2; return 1; }
  VAMPIRE_ROOT_PARTUUID=$root_partuuid

  if [ "$mode" = uefi ]; then
    mkdir -p "$work/target/boot/efi"
    mount "$part1" "$work/target/boot/efi"
    mounted_esp=1
    esp_uuid=$(blkid -s UUID -o value "$part1")
    [ -n "$esp_uuid" ] || { echo "ERROR: unable to read EFI filesystem UUID." >&2; return 1; }
    configure_installed_root "$work/target" "$root_uuid" uefi "$esp_uuid"
    grub-install --target=x86_64-efi --efi-directory="$work/target/boot/efi" --boot-directory="$work/target/boot" --bootloader-id=VampireOS --removable --no-nvram "$device"
  else
    configure_installed_root "$work/target" "$root_uuid" bios
    grub-install --target=i386-pc --boot-directory="$work/target/boot" "$device"
  fi

  # Do not report success merely because grub-install returned zero: verify
  # that the expected firmware boot files and generated configuration exist.
  [ -s "$work/target/boot/grub/grub.cfg" ] || {
    echo "ERROR: installed GRUB configuration is missing." >&2
    return 1
  }
  if [ "$mode" = uefi ]; then
    [ -s "$work/target/boot/efi/EFI/BOOT/BOOTX64.EFI" ] || {
      echo "ERROR: removable-media UEFI bootloader was not created." >&2
      return 1
    }
  else
    [ -s "$work/target/boot/grub/i386-pc/core.img" ] || {
      echo "ERROR: BIOS GRUB core image was not created." >&2
      return 1
    }
  fi
  sync
  echo "Vampire OS files and GRUB were installed. Unmounting target..."
  cleanup_install || return 1
  trap - EXIT HUP INT TERM
  echo "Installation stage completed. Remove the live medium and reboot."
  echo "Physical hardware and installed-disk boot still require validation."
}
configure_installed_root() {
  [ "$(id -u)" -eq 0 ] || { printf "ERROR: root privileges are required to configure an installed system\\n" >&2; return 1; }
  target_root=$1
  root_uuid=$2
  firmware=$3
  esp_uuid=${4:-}
  configure_script=${VAMPIRE_INSTALL_CONFIGURER:-/usr/lib/vampire/configure-installed-root.py}
  [ -d "$target_root" ] || { printf 'ERROR: target root directory does not exist: %s\n' "$target_root" >&2; return 2; }
  [ -r "$configure_script" ] || { printf 'ERROR: installed-root configurator missing: %s\n' "$configure_script" >&2; return 1; }
  case "$firmware" in uefi|bios) ;; *) printf 'ERROR: firmware mode must be uefi or bios\n' >&2; return 2 ;; esac
  if [ "$firmware" = uefi ]; then
    [ -n "$esp_uuid" ] || { printf 'ERROR: UEFI requires ESP UUID\n' >&2; return 2; }
    python3 "$configure_script" "$target_root" "$root_uuid" "$firmware" --esp-uuid "$esp_uuid" --root-partuuid "${VAMPIRE_ROOT_PARTUUID:?missing root PARTUUID}"
    return $?
  fi
  [ -z "$esp_uuid" ] || { printf 'ERROR: BIOS mode does not accept ESP UUID\n' >&2; return 2; }
  python3 "$configure_script" "$target_root" "$root_uuid" "$firmware" --root-partuuid "${VAMPIRE_ROOT_PARTUUID:?missing root PARTUUID}"
  return $?
}

case "${1:-help}" in
  system-check)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    system_check
    ;;
  list)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    list_disks
    ;;
  preflight)
    [ "$#" -eq 2 ] || { usage >&2; exit 2; }
    preflight "$2"
    ;;
  validate)
    [ "$#" -eq 2 ] || { usage >&2; exit 2; }
    validate_rootfs "$2"
    ;;
  requirements)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    installer_requirements
    ;;
  stage)
    [ "$#" -eq 3 ] || { usage >&2; exit 2; }
    stage_rootfs "$2" "$3"
    ;;
  configure)
    [ "$#" -ge 4 ] && [ "$#" -le 5 ] || { usage >&2; exit 2; }
    configure_installed_root "$2" "$3" "$4" "${5:-}"
    ;;
  plan)
    [ "$#" -ge 2 ] && [ "$#" -le 3 ] || { usage >&2; exit 2; }
    installation_plan "$2" "${3:-}"
    ;;
  install)
    [ "$#" -ge 3 ] && [ "$#" -le 4 ] || { usage >&2; exit 2; }
    install_system "$2" "$3" "${4:-}"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
