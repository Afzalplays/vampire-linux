#!/bin/sh
# Vampire OS installer discovery/preflight. Intentionally read-only.
set -eu
SYS_BLOCK=${VAMPIRE_SYS_BLOCK:-/sys/block}
DEV_ROOT=${VAMPIRE_DEV_ROOT:-/dev}
MOUNTS_FILE=${VAMPIRE_MOUNTS_FILE:-/proc/mounts}
MOUNTINFO_FILE=${VAMPIRE_MOUNTINFO_FILE:-/proc/self/mountinfo}
SWAPS_FILE=${VAMPIRE_SWAPS_FILE:-/proc/swaps}
MIN_SECTORS=16777216 # 8 GiB using 512-byte sectors
usage() {
  cat <<'EOF'
Vampire Installer — read-only readiness and storage checks
Usage:
  vinstall system-check
  vinstall list
  vinstall preflight /dev/DEVICE
  vinstall plan /dev/DEVICE [uefi|bios]
  vinstall requirements
  vinstall help
This developer build does NOT partition, format, mount, or write to disks.
The plan command only prints a proposed layout; it never executes it.
EOF
}
disk_name() {
  case "$1" in "$DEV_ROOT"/*) name=${1#"$DEV_ROOT"/} ;; *) return 1 ;; esac
  case "$name" in ""|*/*|*[!A-Za-z0-9._-]*) return 1 ;; esac
  printf '%s\n' "$name"
}
read_attr() {
  file=$1
  if [ -r "$file" ]; then IFS= read -r value < "$file" || value=; printf '%s' "$value"
  else printf '?'; fi
}
is_partition() { [ -r "$1/partition" ]; }
canonical_device() {
  if command -v readlink >/dev/null 2>&1; then
    resolved=$(readlink -f "$1" 2>/dev/null || true)
    [ -n "$resolved" ] && { printf '%s\n' "$resolved"; return 0; }
  fi
  printf '%s\n' "$1"
}
resolve_sys_block() {
  candidate="$SYS_BLOCK/$1"
  if [ -d "$candidate" ]; then printf '%s\n' "$candidate"; return 0; fi
  for child in "$SYS_BLOCK"/*/"$1"; do
    [ -d "$child" ] || continue
    printf '%s\n' "$child"
    return 0
  done
  return 1
}
installer_requirements() {
  printf 'Vampire OS installer tool readiness (diagnostic only)\n'
  missing=0
  for tool in sfdisk parted mkfs.fat mkfs.ext4 mount umount grub-install blkid tar python3; do
    if command -v "$tool" >/dev/null 2>&1; then
      printf 'AVAILABLE  %s\n' "$tool"
    else
      printf 'MISSING    %s\n' "$tool"
      missing=1
    fi
  done
  if [ "$missing" -eq 0 ]; then
    printf 'All disk-installation prerequisites are present; this does not authorize or perform installation.\n'
  else
    printf 'Installer execution is unavailable until every prerequisite is installed.\n'
    return 1
  fi
}

system_check() {
  printf 'Vampire OS installation environment check\n'
  arch=$(uname -m 2>/dev/null || echo unknown)
  printf 'Architecture: %s\n' "$arch"
  case "$arch" in x86_64|amd64) ;; *) echo 'BLOCKER: this image targets x86_64/AMD64.'; return 1 ;; esac
  if [ -d /sys/firmware/efi ]; then firmware=UEFI
  else firmware=Legacy-BIOS-or-unknown; fi
  printf 'Firmware: %s\n' "$firmware"
  mem_kib=$(awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null || true)
  case "$mem_kib" in ''|*[!0-9]*) echo 'WARNING: system memory could not be detected.' ;;
    *) mem_mib=$((mem_kib / 1024)); printf 'Memory: %s MiB\n' "$mem_mib"
       [ "$mem_mib" -ge 1024 ] || echo 'WARNING: less than 1 GiB RAM; installation/live use may be unreliable.' ;;
  esac
  for tool in sh awk mount; do
    if command -v "$tool" >/dev/null 2>&1; then printf 'Tool %-8s available\n' "$tool"
    else printf 'WARNING: required diagnostic tool missing: %s\n' "$tool"; fi
  done
  echo 'This command is diagnostic only; it has not changed storage.'
}
list_disks() {
  [ -d "$SYS_BLOCK" ] || { printf 'Block-device inventory unavailable.\n' >&2; return 1; }
  printf '%-18s %10s %-5s %-5s %s\n' DEVICE SIZE_MiB RO REMOVABLE MODEL
  found=0
  for path in "$SYS_BLOCK"/*; do
    [ -d "$path" ] || continue
    is_partition "$path" && continue
    name=${path##*/}
    case "$name" in loop*|ram*|zram*) continue ;; esac
    sectors=$(read_attr "$path/size")
    case "$sectors" in ''|*[!0-9]*) continue ;; esac
    mib=$((sectors / 2048))
    ro=$(read_attr "$path/ro"); removable=$(read_attr "$path/removable")
    model=$(read_attr "$path/device/model")
    printf '%-18s %10s %-5s %-5s %s\n' "$DEV_ROOT/$name" "$mib" "$ro" "$removable" "$model"
    found=1
  done
  [ "$found" -eq 1 ] || printf 'No whole-disk devices detected.\n'
}
preflight() {
  device=$1
  name=$(disk_name "$device") || { printf 'ERROR: use a direct device path below %s.\n' "$DEV_ROOT" >&2; return 2; }
  [ -e "$DEV_ROOT/$name" ] || { printf 'ERROR: device does not exist: %s\n' "$device" >&2; return 2; }
  sys=$(resolve_sys_block "$name") || { printf 'ERROR: no sysfs block-device record for %s.\n' "$device" >&2; return 2; }
  is_partition "$sys" && { printf 'ERROR: select the whole disk, not a partition: %s\n' "$device" >&2; return 2; }
  sectors=$(read_attr "$sys/size")
  case "$sectors" in ''|*[!0-9]*) printf 'ERROR: cannot read device capacity.\n' >&2; return 2 ;; esac
  ro=$(read_attr "$sys/ro"); removable=$(read_attr "$sys/removable")
  mib=$((sectors / 2048))
  printf 'Vampire Installer storage preflight: %s\n' "$device"
  printf 'Capacity: %s MiB\nRead-only: %s\nRemovable: %s\n' "$mib" "$ro" "$removable"
  ready=1
  if [ "$sectors" -lt "$MIN_SECTORS" ]; then printf 'BLOCKER: disk is smaller than the 8 GiB minimum target.\n'; ready=0; fi
  if [ "$ro" = 1 ]; then printf 'BLOCKER: kernel reports this device as read-only.\n'; ready=0; fi
  if [ "$removable" = 1 ]; then printf 'WARNING: this is marked as removable media; verify the target carefully.\n'; fi
  if [ -r "$MOUNTS_FILE" ] && [ -r "$MOUNTINFO_FILE" ] && [ -r "$SWAPS_FILE" ]; then
    target_real=$(canonical_device "$device")
    # Refuse stacked devices (LVM, RAID, dm-crypt, multipath) rather than
    # guessing whether modifying their backing disk is safe.
    for node in "$sys" "$sys"/*; do
      [ -d "$node" ] || continue
      [ "$node" = "$sys" ] || is_partition "$node" || continue
      holders="$node/holders"
      if [ -d "$holders" ]; then
        for holder in "$holders"/*; do
          [ -e "$holder" ] || continue
          printf 'BLOCKER: device is backing an active stacked block device (%s).\n' "${holder##*/}"
          ready=0
        done
      fi
      node_dev=$(read_attr "$node/dev")
      case "$node_dev" in
        ''|\?|*[!0-9:]*|:*|*:)
          printf 'BLOCKER: cannot verify active mounts for %s; sysfs major:minor is unavailable.\n' "${node##*/}"
          ready=0
          node_dev= ;;
      esac
      if [ -n "$node_dev" ]; then
        mounted_points=$(awk -v dev="$node_dev" '$3 == dev {print $5}' "$MOUNTINFO_FILE")
        if [ -n "$mounted_points" ]; then
          while IFS= read -r mountpoint; do
            [ -n "$mountpoint" ] || continue
            printf 'BLOCKER: device or partition is mounted at %s (major:minor %s).\n' "$mountpoint" "$node_dev"
            ready=0
          done <<EOF_MOUNTED
$mounted_points
EOF_MOUNTED
        fi
      fi
    done
    # Swap is not listed in mount tables; check its source explicitly.
    while IFS=' ' read -r swap_source rest; do
      [ -n "$swap_source" ] || continue
      [ "$swap_source" = Filename ] && continue
      case "$swap_source" in "$DEV_ROOT"/*)
        swap_real=$(canonical_device "$swap_source")
        if [ "$swap_real" = "$target_real" ]; then
          printf 'BLOCKER: target disk is active swap: %s\n' "$swap_source"
          ready=0
        else
          for part in "$sys"/*; do
            [ -d "$part" ] && is_partition "$part" || continue
            part_name=${part##*/}
            part_real=$(canonical_device "$DEV_ROOT/$part_name")
            if [ "$swap_real" = "$part_real" ]; then
              printf 'BLOCKER: target partition is active swap: %s\n' "$swap_source"
              ready=0
            fi
          done
        fi ;;
      esac
    done < "$SWAPS_FILE"
    for part in "$sys"/*; do
      [ -d "$part" ] && is_partition "$part" || continue
      part_name=${part##*/}
      part_real=$(canonical_device "$DEV_ROOT/$part_name")
      [ -e "$DEV_ROOT/$part_name" ] || continue
      while IFS=' ' read -r source mountpoint rest; do
        case "$source" in "$DEV_ROOT"/*)
          source_real=$(canonical_device "$source")
          if [ "$source_real" = "$target_real" ] || [ "$source_real" = "$part_real" ]; then
            printf 'BLOCKER: device or partition is mounted at %s (%s).\n' "$mountpoint" "$source"
            ready=0
          fi ;;
        esac
      done < "$MOUNTS_FILE"
    done
    while IFS=' ' read -r source mountpoint rest; do
      case "$source" in "$DEV_ROOT"/*)
        source_real=$(canonical_device "$source")
        if [ "$source_real" = "$target_real" ]; then
          printf 'BLOCKER: target disk is mounted at %s (%s).\n' "$mountpoint" "$source"
          ready=0; mounted=1
        fi ;;
      esac
    done < "$MOUNTS_FILE"
  else
    printf 'BLOCKER: mount, mountinfo or swap table unavailable; refusing to approve a disk without complete active-use checks.\n'
    ready=0
  fi
  if [ "$ready" -eq 1 ]; then
    printf 'PREFLIGHT: basic checks passed. No disk changes were made.\n'
  else
    printf 'PREFLIGHT: do not install to this device until blockers are resolved.\n'
    return 1
  fi
}

installation_plan() {
  device=$1
  mode=${2:-}
  case "$mode" in
    "") if [ -d /sys/firmware/efi ]; then mode=uefi; else mode=bios; fi ;;
    uefi|bios) ;;
    *) printf 'ERROR: firmware mode must be uefi or bios.\n' >&2; return 2 ;;
  esac
  preflight "$device" || return $?
  name=$(disk_name "$device") || return 2
  sys=$(resolve_sys_block "$name") || return 2
  sectors=$(read_attr "$sys/size")
  mib=$((sectors / 2048))
  printf '\nVampire OS proposed installation layout (READ-ONLY PLAN)\n'
  printf 'Target: %s\nFirmware: %s\nDisk capacity: %s MiB\n' "$device" "$mode" "$mib"
  if [ "$mode" = uefi ]; then
    printf 'Partition table: GPT\n'
    printf '1) 512 MiB  EFI System Partition (FAT32), mount at /boot/efi\n'
    printf '2) Remaining space  Linux filesystem (ext4), mount at /\n'
  else
    printf 'Partition table: GPT\n'
    printf '1) 2 MiB  BIOS boot partition (unformatted, GRUB bios_grub flag)\n'
    printf '2) Remaining space  Linux filesystem (ext4), mount at /\n'
  fi
  printf '\nNo partition table was written. No filesystem was created. No data was changed.\n'
  printf 'This is a proposal only; installer execution and user confirmation are not implemented.\n'
}

case "${1:-help}" in
  system-check) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; system_check ;;
  list) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; list_disks ;;
  preflight) [ "$#" -eq 2 ] || { usage >&2; exit 2; }; preflight "$2" ;;
  requirements) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; installer_requirements ;;
  plan) [ "$#" -ge 2 ] && [ "$#" -le 3 ] || { usage >&2; exit 2; }; installation_plan "$2" "${3:-}" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
