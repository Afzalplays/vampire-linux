#!/bin/sh
set -eu
unknown() { [ -n "$1" ] && printf '%s' "$1" || printf Unknown; }
echo 'VAMPIRE HARDWARE'
printf 'Architecture: %s\nKernel: %s\n' "$(uname -m)" "$(uname -r)"
cpu=$(awk -F: '/^(model name|Hardware)[[:space:]]*:/ {sub(/^[ \t]+/,"",$2); print $2; exit}' /proc/cpuinfo 2>/dev/null || true)
cores=$(grep -c '^processor[[:space:]]*:' /proc/cpuinfo 2>/dev/null || true)
mem=$(awk '/^MemTotal:/ {printf "%d MiB", $2/1024}' /proc/meminfo 2>/dev/null || true)
printf 'CPU: %s\nLogical CPUs: %s\nMemory: %s\n' "$(unknown "$cpu")" "$(unknown "$cores")" "$(unknown "$mem")"
for id in /sys/class/drm/card[0-9]*/device; do
 [ -d "$id" ] || continue
 printf 'GPU: vendor=%s device=%s\n' "$(cat "$id/vendor" 2>/dev/null || echo unknown)" "$(cat "$id/device" 2>/dev/null || echo unknown)"
done
echo 'Block devices:'
for disk in /sys/block/*; do
 [ -e "$disk" ] || continue
 name=$(basename "$disk"); case "$name" in loop*|ram*) continue ;; esac
 sectors=$(cat "$disk/size" 2>/dev/null || echo 0)
 awk -v n="$name" -v s="$sectors" 'BEGIN {printf "  %s %.2f GiB\n",n,s*512/1073741824}'
done
echo 'Network interfaces:'
for net in /sys/class/net/*; do [ -e "$net" ] || continue; printf '  %s %s\n' "$(basename "$net")" "$(cat "$net/operstate" 2>/dev/null || echo unknown)"; done
