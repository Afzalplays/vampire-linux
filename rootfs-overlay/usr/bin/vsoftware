#!/bin/sh
# Vampire Software Center — keyboard-driven package-manager frontend.
set -eu
VPM=${VAMPIRE_VPM_CMD:-vpm}
pause() { printf '\nPress Enter to continue...'; IFS= read -r _ || true; }
confirm() {
  printf '%s [y/N]: ' "$1"
  IFS= read -r answer || return 1
  case "$answer" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}
run_vpm() {
  if "$VPM" "$@"; then :; else
    status=$?
    printf 'VPM command failed (exit %s). Check repository readiness above.\n' "$status"
  fi
}
printf '  V A M P I R E  /  SOFTWARE\n'
printf '  Repository readiness:\n'
"$VPM" doctor || printf '  Configure a signed repository before package installation.\n'
while :; do
  printf '\n'
  printf '  -------------------------\n'
  printf '  1) Refresh signed package indexes\n'
  printf '  2) Search packages\n'
  printf '  3) Package information\n'
  printf '  4) Install package\n'
  printf '  5) Remove package\n'
  printf '  6) Installed packages\n'
  printf '  0) Exit\n'
  printf '  Select: '
  IFS= read -r choice || exit 0
  case "$choice" in
    1) run_vpm update; pause ;;
    2)
      printf 'Search: '; IFS= read -r term
      if [ -n "$term" ]; then run_vpm search "$term"; fi
      pause ;;
    3)
      printf 'Package name: '; IFS= read -r pkg
      if [ -n "$pkg" ]; then run_vpm info "$pkg"; fi
      pause ;;
    4)
      printf 'Package name: '; IFS= read -r pkg
      if [ -n "$pkg" ] && confirm "Install $pkg?"; then run_vpm install "$pkg" -y
      else echo "Install cancelled."; fi
      pause ;;
    5)
      printf 'Package name: '; IFS= read -r pkg
      if [ -n "$pkg" ] && confirm "Remove $pkg and its recorded files?"; then run_vpm remove "$pkg"
      else echo "Removal cancelled."; fi
      pause ;;
    6) run_vpm list; pause ;;
    0) exit 0 ;;
    *) echo "Invalid choice." ;;
  esac
done
