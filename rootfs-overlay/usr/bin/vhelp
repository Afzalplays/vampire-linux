#!/bin/sh
# Vampire OS command reference.
set -eu
cat <<'EOF'
  V A M P I R E  O S
  Command Reference
  =================

SYSTEM
  vfetch                         Show system identity and hardware summary
  vdesktop                       Open the Vampire Desktop console launcher
  vpower status                  Show uptime and power command availability
  vpower reboot --yes            Reboot after explicit acknowledgement (root)
  vpower poweroff --yes          Power off after explicit acknowledgement (root)
  vpower halt --yes              Halt after explicit acknowledgement (root)
  vhelp                          Show this command reference
  vsh                            Start the Vampire Shell
  vsettings list|keys|get|set    Read or change validated desktop preferences
  vsettings validate|reset      Validate or restore default preferences
  vsettings apply                Apply theme, accent, panel and terminal settings

NETWORK AND SERVICES
  vnetwork status [IFACE]        Show interface and DHCP state
  vnetwork start|stop [IFACE]    Start or stop DHCP networking
  vnetwork restart [IFACE]       Renew the network connection
  vnetwork wifi list             List detected wireless interfaces
  vnetwork wifi scan IFACE       Scan for nearby access points
  vnetwork wifi connect IFACE SSID  Connect with a hidden passphrase prompt
  vnetwork wifi status IFACE     Show Wi-Fi association and DHCP status
  vnetwork wifi disconnect IFACE Disconnect from a wireless network
  vctl list                      List available services
  vctl start|stop SERVICE        Control an installed service
  vctl restart|status SERVICE    Restart or inspect a service
  vctl enable|disable SERVICE    Change boot-time service selection\n  vctl status-all                Inspect all boot-enabled services

SOFTWARE AND UPDATES
  vpm doctor                     Check package manager prerequisites
  vpm update                     Refresh signed package indexes
  vpm search|info PACKAGE        Search or inspect a package
  vpm install|remove PACKAGE     Install or remove a package
  vpm list                       List installed packages
  vsoftware                     Open the console Software Center
  vupdate check                  Verify the configured signed update manifest
  vupdate download               Download and verify an update image
  vupdate status                 List staged images in the local cache
  vupdate verify [FILE]           Recheck a staged image against signed metadata

FILES AND ADMINISTRATION
  vfiles                         Open the console file manager
  vinstall list                  List available installation disks
  vinstall preflight /dev/DISK   Check a target without writing to it
  vinstall plan /dev/DISK [uefi|bios]  Preview a read-only disk layout
  vssh status                    Inspect the optional SSH service
  vssh start                     Start key-only SSH after installing a trusted key
  vguard status|apply|clear      Inspect or manage the firewall rules

POWER MANAGEMENT
  Power actions require root and --yes; the console asks for typed confirmation.

DIAGNOSTICS
  vmonitor [--once|--watch [SECONDS]]  Show resource and thermal telemetry
  vhardware                      Show detected hardware
  vstorage                       Show block devices and mounts
  vhealth                        Run system health checks
  vlogs [--follow] [--lines N]   Inspect recent or live system logs
  vdiagnose                      Print a support snapshot
  vdiagnose --save [DIRECTORY]   Save a private mode-600 support report
  vfirewall status               Show firewall state

SAFETY NOTES
  - The current installer only lists disks and runs read-only preflight checks.
  - VPM and OS updates are experimental; a production package repository and
    transactional rollback are not yet available.
  - SSH is opt-in and refuses to start without a supported public key.
  - Use root privileges only for commands that require system administration.
EOF
