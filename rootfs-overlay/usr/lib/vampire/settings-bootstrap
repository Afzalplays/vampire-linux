#!/bin/sh
# Safely initialize or recover the persistent desktop settings file.
set -eu
umask 077

CONFIG=${VAMPIRE_SETTINGS_FILE:-/etc/vampire/settings.conf}
DEFAULTS=${VAMPIRE_SETTINGS_DEFAULTS:-/etc/vampire/settings.defaults}
VALIDATOR=${VAMPIRE_SETTINGS_VALIDATOR:-/usr/bin/vsettings}
BACKUP_DIR=${VAMPIRE_SETTINGS_BACKUP_DIR:-/var/lib/vampire}

log() { printf 'Vampire OS: %s\n' "$*" >&2; }

reject_config_path_symlinks() {
  check_path=${1:-$CONFIG}
  case "$check_path" in /*) ;; *) check_path=$PWD/$check_path ;; esac
  while [ -n "$check_path" ] && [ "$check_path" != "/" ]; do
    [ ! -L "$check_path" ] || {
      log "refusing symlinked settings path: $check_path"
      return 1
    }
    check_path=${check_path%/*}
    [ -n "$check_path" ] || check_path=/
  done
}

install_defaults() {
  reject_config_path_symlinks "$BACKUP_DIR" || return 1
  [ -r "$DEFAULTS" ] || { log "settings defaults are unavailable"; return 1; }
  dir=${CONFIG%/*}
  [ "$dir" != "$CONFIG" ] || dir=.
  mkdir -p "$dir" "$BACKUP_DIR"
  tmp="$CONFIG.tmp.$$"
  (set -C; : > "$tmp") 2>/dev/null || {
    log "settings staging file already exists; current settings left untouched"
    return 1
  }
  trap 'rm -f "$tmp"' 0
  trap 'exit 1' HUP INT TERM
  if ! cat "$DEFAULTS" > "$tmp"; then
    log "could not stage settings defaults"
    return 1
  fi
  if ! VAMPIRE_SETTINGS_FILE="$tmp" VAMPIRE_SETTINGS_DEFAULTS="$DEFAULTS" "$VALIDATOR" validate >/dev/null 2>&1; then
    log "refusing invalid settings defaults"
    return 1
  fi
  chmod 600 "$tmp"
  if ! mv -f "$tmp" "$CONFIG"; then
    log "could not atomically install settings defaults"
    return 1
  fi
  trap - 0 HUP INT TERM
}

reject_config_path_symlinks || { log "current settings left untouched"; exit 1; }

if [ ! -e "$CONFIG" ]; then
  install_defaults || exit 1
  exit 0
fi

if "$VALIDATOR" validate >/dev/null 2>&1; then
  exit 0
fi

reject_config_path_symlinks "$BACKUP_DIR" || exit 1
mkdir -p "$BACKUP_DIR"
chmod 700 "$BACKUP_DIR"
backup=$(mktemp "$BACKUP_DIR/settings.conf.invalid.XXXXXX") || {
  log "could not allocate a private settings backup; leaving settings untouched"
  exit 1
}
if cp "$CONFIG" "$backup" && chmod 600 "$backup"; then
  log "invalid settings backed up to $backup"
else
  rm -f "$backup"
  log "could not back up invalid settings; leaving them untouched"
  exit 1
fi
if install_defaults; then
  log "invalid settings replaced with validated defaults"
else
  log "invalid settings retained because defaults could not be installed safely"
  exit 1
fi
