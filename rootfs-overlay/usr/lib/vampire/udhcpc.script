#!/bin/sh
# BusyBox udhcpc lease hook. DHCP-provided values are validated before use.
set -eu
RESOLV_CONF=\${VAMPIRE_RESOLV_CONF:-/etc/resolv.conf}
valid_iface() {
  case "$1" in ''|*[!A-Za-z0-9_.-]*) return 1 ;; esac
  [ "\${#1}" -le 15 ]
}
valid_ipv4() {
  printf '%s\n' "$1" | awk -F. '
    NF != 4 { exit 1 }
    { for (i=1; i<=4; i++) if ($i !~ /^[0-9]+$/ || $i > 255) exit 1 }
    END { if (NR != 1) exit 1 }
  '
}
action=\${1:-}
interface=\${interface:-}
valid_iface "$interface" || { echo "udhcpc hook: invalid interface" >&2; exit 1; }
case "$action" in
  deconfig)
    if command -v ifconfig >/dev/null 2>&1; then ifconfig "$interface" 0.0.0.0 || true; fi
    rm -f "$RESOLV_CONF"
    ;;
  bound|renew)
    ip=\${ip:-}
    subnet=\${subnet:-255.255.255.0}
    valid_ipv4 "$ip" && valid_ipv4 "$subnet" || {
      echo "udhcpc hook: invalid IPv4 address or subnet mask" >&2; exit 1;
    }
    command -v ifconfig >/dev/null 2>&1 || { echo "udhcpc hook: ifconfig is unavailable" >&2; exit 127; }
    ifconfig "$interface" "$ip" netmask "$subnet" up
    if [ -n "\${router:-}" ]; then
      set -f
      for gateway in $router; do
        valid_ipv4 "$gateway" || { echo "udhcpc hook: invalid router address" >&2; exit 1; }
        if command -v route >/dev/null 2>&1; then
          route del default dev "$interface" 2>/dev/null || true
          route add default gw "$gateway" dev "$interface"
        fi
        break
      done
      set +f
    fi
    dir=\${RESOLV_CONF%/*}
    [ "$dir" = "$RESOLV_CONF" ] && dir=.
    mkdir -p "$dir"
    tmp="$RESOLV_CONF.tmp.$$"
    trap 'rm -f "$tmp"' 0 HUP INT TERM
    : > "$tmp"
    if [ -n "\${dns:-}" ]; then
      set -f
      count=0
      for server in $dns; do
        valid_ipv4 "$server" || { echo "udhcpc hook: invalid DNS address" >&2; exit 1; }
        printf 'nameserver %s\n' "$server" >> "$tmp"
        count=$((count + 1))
        [ "$count" -lt 3 ] || break
      done
      set +f
    fi
    if [ -n "\${domain:-}" ]; then
      case "$domain" in *[!A-Za-z0-9.-]*) ;; *) printf 'search %s\n' "$domain" >> "$tmp" ;; esac
    fi
    chmod 644 "$tmp"
    mv -f "$tmp" "$RESOLV_CONF"
    trap - 0 HUP INT TERM
    ;;
  *) echo "udhcpc hook: unsupported action: $action" >&2; exit 2 ;;
esac
