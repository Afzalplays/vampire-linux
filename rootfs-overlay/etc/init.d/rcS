#!/bin/sh
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mkdir -p /dev/pts /run /tmp /var/log /var/lib/vampire
mount -t devpts devpts /dev/pts 2>/dev/null || true
hostname vampire-os
if command -v udevd >/dev/null 2>&1; then
  udevd --daemon || true
  if command -v udevadm >/dev/null 2>&1; then
    udevadm trigger --type=subsystems --action=add || true
    udevadm trigger --type=devices --action=add || true
    udevadm settle --timeout=10 || true
  fi
fi
if [ ! -f /etc/vampire/settings.conf ] && [ -r /etc/vampire/settings.defaults ]; then
  cp /etc/vampire/settings.defaults /etc/vampire/settings.conf
  chmod 600 /etc/vampire/settings.conf
fi
if [ -x /usr/bin/vsettings ] && [ -f /etc/vampire/settings.conf ]; then
  if ! /usr/bin/vsettings validate >/dev/null 2>&1; then
    if [ -r /etc/vampire/settings.defaults ]; then
      cp /etc/vampire/settings.conf /var/lib/vampire/settings.conf.invalid 2>/dev/null || true
      cp /etc/vampire/settings.defaults /etc/vampire/settings.conf.tmp
      chmod 600 /etc/vampire/settings.conf.tmp
      mv -f /etc/vampire/settings.conf.tmp /etc/vampire/settings.conf
      printf 'Vampire OS: invalid settings backed up; defaults restored\n' >&2
    else
      printf 'Vampire OS: invalid settings and defaults unavailable\n' >&2
    fi
  fi
fi
printf '\n  Vampire OS 0.1.0-dev | x86_64 live environment\n'
printf '  Type vfetch for system information.\n\n'
if [ -x /usr/bin/vctl ]; then
  /usr/bin/vctl start-all || printf 'Vampire OS: one or more services failed to start\n' >&2
fi
