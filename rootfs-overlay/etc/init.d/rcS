#!/bin/sh
# Minimal live-system initialization for Vampire OS.
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mkdir -p /dev/pts /run /tmp /var/log
mount -t devpts devpts /dev/pts 2>/dev/null || true
hostname vampire-os

# Seed writable live-session preferences on first boot.
if [ ! -f /etc/vampire/settings.conf ] && [ -r /etc/vampire/settings.defaults ]; then
  cp /etc/vampire/settings.defaults /etc/vampire/settings.conf
  chmod 600 /etc/vampire/settings.conf
fi

printf '\n'
printf '  Vampire OS 0.1.0-dev | x86_64 live environment\n'
printf '  Type vfetch for system information.\n'
printf '\n'

# Bring up DHCP when a supported NIC is present. A missing NIC or DHCP
# server must never prevent the live console from starting.
if [ -x /usr/bin/vctl ]; then
  /usr/bin/vctl start network || printf 'Vampire OS: network startup skipped or failed\n' >&2
fi
