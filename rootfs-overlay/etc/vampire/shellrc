# Vampire Shell interactive profile (Bash execution engine).
# Keep this file safe to source in both interactive and non-interactive vsh calls.
umask 077
HISTFILE="${VAMPIRE_HISTORY_FILE:-/var/lib/vampire/shell_history}"
HISTSIZE=2000
HISTFILESIZE=4000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend checkwinsize
export HISTFILE HISTSIZE HISTFILESIZE HISTCONTROL
export EDITOR="${EDITOR:-vi}"
export PAGER="${PAGER:-less}"

if [[ $- == *i* ]]; then
  # Distinctive crimson prompt; non-interactive commands receive no escape codes.
  PS1='\[\033[1;31m\]vampire\[\033[0m\] \u@\h \[\033[1;34m\]\w\[\033[0m\] \$ '
  alias ll='ls -alF'
  alias la='ls -A'
  alias ..='cd ..'
  alias vinfo='vfetch'
  alias help='vhelp'
  printf '\033[1;31mVampire Shell\033[0m  |  Type vhelp for the command reference.\n'
fi
