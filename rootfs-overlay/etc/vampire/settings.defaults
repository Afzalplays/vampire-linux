# Vampire Desktop preference defaults (key=value; no secrets).
theme=dark
accent=crimson
surface_transparency=30
blur=medium
terminal_opacity=90
dock_size=medium
dock_position=bottom-center
dock_auto_hide=true
dock_magnification=true
top_panel=true
show_date=true
show_clock=true
show_network=true
show_power=true
reduced_motion=false
update_channel=stable
voice_access=false
