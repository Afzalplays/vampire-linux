VAMPIRE_MOBILE_SHELL_VERSION = 1.0
VAMPIRE_MOBILE_SHELL_SITE = $(BR2_EXTERNAL_VAMPIRE_MOBILE_PATH)/package/vampire-mobile-shell/src
VAMPIRE_MOBILE_SHELL_SITE_METHOD = local
VAMPIRE_MOBILE_SHELL_DEPENDENCIES = sdl2 sdl2_ttf dejavu

define VAMPIRE_MOBILE_SHELL_BUILD_CMDS
	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) CC="$(TARGET_CC)" PKG_CONFIG="$(PKG_CONFIG_HOST_BINARY)" CFLAGS="$(TARGET_CFLAGS)" LDFLAGS="$(TARGET_LDFLAGS)"
endef

define VAMPIRE_MOBILE_SHELL_INSTALL_TARGET_CMDS
	$(INSTALL) -D -m 0755 $(@D)/vampire-mobile-shell $(TARGET_DIR)/usr/bin/vampire-mobile-shell
endef

$(eval $(generic-package))
