#!/bin/sh
# ARM64 mobile bring-up init; deliberately does not run the x86 desktop installer.
set -u
log(){ printf 'Vampire Mobile boot: %s\n' "$*" >&2; }
mount_one(){ mount -t "$1" "$3" "$2" 2>/dev/null || log "could not mount $1 on $2"; }
mount_one proc /proc proc
mount_one sysfs /sys sysfs
mount_one devtmpfs /dev devtmpfs
mkdir -p /dev/pts /run /tmp /var/log /var/lib/vampire /run/vampire
mount_one devpts /dev/pts devpts
chmod 1777 /tmp 2>/dev/null || true
hostname vampire-mobile 2>/dev/null || true
if command -v udevd >/dev/null 2>&1; then
  udevd --daemon || log "udev did not start"
  if command -v udevadm >/dev/null 2>&1; then
    udevadm trigger --type=subsystems --action=add || true
    udevadm trigger --type=devices --action=add || true
    udevadm settle --timeout=10 || log "udev settle timed out"
  fi
fi
printf '\n  VAMPIRE MOBILE OS | ARM64 bring-up\n'
printf '  Device: QEMU virt (generic emulator target)\n'
printf '  Architecture: '
uname -m 2>/dev/null || printf 'unknown\n'
printf '  This is an early console image, not a phone-ready release.\n'
printf '  Type vmobile for the mobile system menu.\n\n'
