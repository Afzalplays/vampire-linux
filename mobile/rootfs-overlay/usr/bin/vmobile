#!/bin/sh
# Minimal native ARM64 bring-up console; no fake phone hardware controls.
set -eu
while :; do
  printf '\n  VAMPIRE MOBILE OS\n'
  printf '  1) System information\n'
  printf '  2) Network interfaces\n'
  printf '  3) Display and input devices\n'
  printf '  4) Open shell\n'
  printf '  5) Reboot\n'
  printf '  6) Power off\n'
  printf '  7) Launch touch UI (local display)\n'
  printf '  0) Exit menu\n'
  printf '  Select: '
  IFS= read -r choice || exit 0
  case "$choice" in
    1) printf '\n'; cat /etc/os-release; printf '\nKernel: '; uname -a; printf '\nMemory:\n'; cat /proc/meminfo | head -n 5 ;;
    2) if command -v ip >/dev/null 2>&1; then ip addr; else printf 'ip utility is not installed.\n'; fi ;;
    3) printf '\nDisplay devices:\n'; ls /sys/class/drm 2>/dev/null || true; printf '\nInput devices:\n'; ls /sys/class/input 2>/dev/null || true; printf '\n' ;;
    4) exec /bin/sh ;;
    5) printf 'Rebooting...\n'; reboot ;;
    6) printf 'Powering off...\n'; poweroff ;;
    7) /usr/bin/vmobile-ui || printf 'Touch UI could not start; returning to console.\n' ;;
    0) exit 0 ;;
    *) printf 'Invalid selection.\n' ;;
  esac
done
