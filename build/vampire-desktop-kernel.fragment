# Intel laptop graphics and Wi-Fi drivers for the Desktop edition.
CONFIG_MODULES=y
CONFIG_FW_LOADER=y
CONFIG_DRM=y
CONFIG_DRM_I915=m
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLDVM=m
CONFIG_IWLWIFI_LEDS=y
