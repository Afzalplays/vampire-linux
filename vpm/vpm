#!/usr/bin/env python3
"""Vampire Package Manager prototype. SPDX-License-Identifier: MIT

Experimental developer client. Not suitable for production system upgrades.
Repository metadata must be signed with minisign; package payloads are SHA-256
verified before extraction. Package scripts are deliberately not executed.
"""
import argparse
import hashlib
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.error
import urllib.parse
import urllib.request

CONFIG = pathlib.Path(os.environ.get("VPM_CONFIG", "/etc/vpm/vpm.json"))
CACHE = pathlib.Path(os.environ.get("VPM_CACHE", "~/.cache/vpm")).expanduser()
DB = pathlib.Path(os.environ.get("VPM_DB", "/var/lib/vpm/installed.json"))
ROOT = pathlib.Path(os.environ.get("VPM_ROOT", "/"))
MAX_INDEX = 8 * 1024 * 1024
MAX_PACKAGE = 1024 * 1024 * 1024

def fail(message):
    print("vpm: error:", message, file=sys.stderr)
    raise SystemExit(1)

def is_https_url(value):
    parsed = urllib.parse.urlparse(value if isinstance(value, str) else "")
    return parsed.scheme == "https" and bool(parsed.netloc) and not parsed.username and not parsed.password

def validate_package_entry(pkg, repo_base):
    if not isinstance(pkg, dict):
        raise ValueError("package entry must be an object")
    name = pkg.get("name")
    version = pkg.get("version")
    digest = pkg.get("sha256")
    url = pkg.get("url")
    depends = pkg.get("depends", [])
    if not isinstance(name, str) or not re.fullmatch(r"[a-z0-9][a-z0-9+._-]{0,127}", name):
        raise ValueError("invalid package name")
    if not isinstance(version, str) or not re.fullmatch(r"[0-9A-Za-z][0-9A-Za-z.+~_-]{0,63}", version):
        raise ValueError("invalid package version for " + name)
    if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-fA-F]{64}", digest):
        raise ValueError("invalid SHA-256 for " + name)
    if not isinstance(url, str) or not is_https_url(urllib.parse.urljoin(repo_base, url)):
        raise ValueError("invalid HTTPS package URL for " + name)
    if not isinstance(depends, list) or any(
            not isinstance(dep, str) or not re.fullmatch(r"[a-z0-9][a-z0-9+._-]{0,127}", dep)
            for dep in depends):
        raise ValueError("invalid dependency list for " + name)
    architecture = pkg.get("architecture", "any")
    if not isinstance(architecture, str) or not re.fullmatch(r"[A-Za-z0-9_+-]{1,32}", architecture):
        raise ValueError("invalid architecture for " + name)
    return pkg

def load_config():
    if not CONFIG.is_file():
        fail(f"configuration not found: {CONFIG} (see vpm/vpm.example.json)")
    try:
        cfg = json.loads(CONFIG.read_text())
        if not isinstance(cfg.get("repositories"), list) or not cfg["repositories"]:
            fail("no repositories configured")
        return cfg
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"cannot read config: {exc}")

def fetch(url, destination, limit):
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme != "https" or not parsed.netloc:
        fail("repository and package URLs must use HTTPS")
    destination = pathlib.Path(destination)
    destination.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(
        prefix="." + destination.name + ".", suffix=".download",
        dir=destination.parent,
    )
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "vpm/0.1"})
        with urllib.request.urlopen(req, timeout=30) as response:
            if response.status != 200:
                fail(f"download returned HTTP {response.status}")
            if not is_https_url(response.geturl()):
                fail("refusing HTTPS downgrade redirect")
            total = 0
            with os.fdopen(fd, "wb") as out:
                fd = -1
                while True:
                    block = response.read(1024 * 1024)
                    if not block:
                        break
                    total += len(block)
                    if total > limit:
                        fail("download exceeds configured size limit")
                    out.write(block)
                out.flush()
                os.fsync(out.fileno())
        os.replace(temp_name, destination)
    except BaseException as exc:
        if fd >= 0:
            try:
                os.close(fd)
            except OSError:
                pass
        try:
            os.unlink(temp_name)
        except OSError:
            pass
        if isinstance(exc, (OSError, urllib.error.URLError)):
            fail(f"download failed: {exc}")
        raise

def verify_signature(index_path, signature_path, public_key):
    if not shutil.which("minisign"):
        fail("minisign is required to verify repository metadata")
    result = subprocess.run(
        ["minisign", "-Vm", str(index_path), "-x", str(signature_path),
         "-P", public_key],
        stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    if result.returncode:
        fail("repository signature verification failed")

def load_index(refresh=False):
    cfg = load_config()
    CACHE.mkdir(parents=True, exist_ok=True)
    merged = {}
    for repo in cfg["repositories"]:
        if not isinstance(repo, dict):
            fail("repository configuration entries must be objects")
        name = repo.get("name", "unnamed")
        if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", name):
            fail("invalid repository name")
        base_url = repo.get("url", "")
        if not is_https_url(base_url):
            fail(f"repository {name} URL must use HTTPS")
        base = base_url.rstrip("/") + "/"
        key = repo.get("minisign_public_key", "")
        if not isinstance(key, str) or not key.strip():
            fail(f"repository {name} has no minisign public key")
        index_file = CACHE / (name + "-index.json")
        sig_file = CACHE / (name + "-index.json.minisig")
        if refresh or not index_file.exists() or not sig_file.exists():
            fetch(urllib.parse.urljoin(base, "index.json"), index_file, MAX_INDEX)
            fetch(urllib.parse.urljoin(base, "index.json.minisig"), sig_file, 65536)
        verify_signature(index_file, sig_file, key)
        try:
            data = json.loads(index_file.read_text())
        except (OSError, json.JSONDecodeError) as exc:
            fail(f"invalid index from {name}: {exc}")
        if data.get("format") != 1 or not isinstance(data.get("packages"), list):
            fail(f"unsupported index format from {name}")
        for pkg in data["packages"]:
            try:
                validate_package_entry(pkg, base)
            except ValueError as exc:
                fail(f"invalid package entry in {name}: {exc}")
            if pkg["name"] in merged:
                fail(f"duplicate package name: {pkg['name']}")
            pkg["_repo_base"] = base
            merged[pkg["name"]] = pkg
    return merged

def installed_db():
    try:
        value = json.loads(DB.read_text())
        return value if isinstance(value, dict) else {}
    except FileNotFoundError:
        return {}
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"installed database is unreadable: {exc}")

def write_installed_db(value):
    """Atomically replace the package database using a private unique temp file."""
    DB.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(
        prefix="." + DB.name + ".", suffix=".tmp", dir=DB.parent
    )
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(value, stream, indent=2)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temp_name, 0o600)
        os.replace(temp_name, DB)
    except BaseException:
        try:
            os.close(fd)
        except OSError:
            pass
        try:
            os.unlink(temp_name)
        except OSError:
            pass
        raise

def command_update(_args):
    index = load_index(refresh=True)
    print(f"Updated package metadata: {len(index)} packages available.")

def command_search(args):
    index = load_index()
    term = args.query.lower()
    found = [p for p in index.values()
             if term in p["name"].lower() or term in p.get("description", "").lower()]
    for p in sorted(found, key=lambda x: x["name"]):
        print(f'{p["name"]:<24} {p["version"]:<14} {p.get("description", "")}')
    if not found:
        print("No matching packages.")

def command_info(args):
    index = load_index()
    pkg = index.get(args.name)
    if not pkg:
        fail(f"package not found: {args.name}")
    for key in ("name", "version", "description", "architecture", "license", "depends", "url", "sha256"):
        if key in pkg:
            print(f"{key}: {pkg[key]}")

def command_list(_args):
    db = installed_db()
    if not db:
        print("No packages recorded as installed.")
    for name, info in sorted(db.items()):
        print(f"{name:<24} {info.get('version', 'unknown')}")

def safe_extract(archive, destination):
    """Extract regular files only; roll back files created if extraction fails."""
    destination = destination.resolve()
    written = []
    created_dirs = []
    with tarfile.open(archive, "r:gz") as tf:
        members = tf.getmembers()
        if len(members) > 10000:
            fail("archive contains too many entries")
        if sum(m.size for m in members if m.isfile()) > 2 * 1024 * 1024 * 1024:
            fail("archive expanded size exceeds safety limit")
        seen = set()
        for member in members:
            if not member.name or member.name.startswith("/") or "\\" in member.name:
                fail(f"unsafe archive path: {member.name!r}")
            target = (destination / member.name).resolve()
            if target != destination and destination not in target.parents:
                fail(f"unsafe archive path: {member.name}")
            relative = target.relative_to(destination).as_posix()
            if relative in seen:
                fail(f"duplicate archive path: {member.name}")
            seen.add(relative)
            if member.issym() or member.islnk() or member.isdev() or member.isfifo():
                fail(f"unsupported special archive entry: {member.name}")
            if not (member.isfile() or member.isdir()):
                fail(f"unsupported archive entry: {member.name}")
        try:
            for member in members:
                target = (destination / member.name).resolve()
                if member.isdir():
                    missing = []
                    parent = target
                    while parent != destination and not parent.exists():
                        missing.append(parent)
                        parent = parent.parent
                    target.mkdir(parents=True, exist_ok=True)
                    for directory in reversed(missing):
                        if directory not in created_dirs:
                            created_dirs.append(directory)
                    continue
                missing = []
                parent = target.parent
                while parent != destination and not parent.exists():
                    missing.append(parent)
                    parent = parent.parent
                target.parent.mkdir(parents=True, exist_ok=True)
                for directory in reversed(missing):
                    if directory not in created_dirs:
                        created_dirs.append(directory)
                target = (destination / member.name).resolve()
                if target != destination and destination not in target.parents:
                    fail(f"unsafe destination path: {member.name}")
                source = tf.extractfile(member)
                if source is None:
                    fail(f"cannot read archive entry: {member.name}")
                with source, target.open("xb") as out:
                    written.append(target)
                    shutil.copyfileobj(source, out)
                target.chmod(member.mode & 0o755)
        except BaseException:
            for path in reversed(written):
                try:
                    path.unlink()
                except OSError:
                    pass
            for path in sorted(set(created_dirs), key=lambda item: len(item.parts), reverse=True):
                try:
                    path.rmdir()
                except OSError:
                    pass
            raise
    return [path.relative_to(destination).as_posix() for path in written]

def rollback_extracted(destination, manifests):
    """Remove only regular files created by earlier package extraction steps."""
    root = pathlib.Path(destination).resolve()
    failures = []
    for files in reversed(manifests):
        for relative in reversed(files):
            if (not isinstance(relative, str) or not relative or relative.startswith("/")
                    or "\\" in relative):
                failures.append(str(relative))
                continue
            parts = pathlib.PurePosixPath(relative).parts
            if not parts or any(part in ("", ".", "..") for part in parts):
                failures.append(relative)
                continue
            target = root
            safe = True
            for part in parts:
                target = target / part
                if target.is_symlink():
                    safe = False
                    break
            if not safe:
                failures.append(relative)
                continue
            try:
                if target.is_file():
                    target.unlink()
            except OSError:
                failures.append(relative)
    return failures


def command_install(args):
    if os.geteuid() != 0 and ROOT == pathlib.Path("/"):
        fail("installation to / requires root; use sudo vpm install PACKAGE")
    index = load_index()
    db = installed_db()
    pending, visiting = [], set()

    def resolve(name):
        if name in db or any(p["name"] == name for p in pending):
            return
        if name in visiting:
            fail(f"dependency cycle involving {name}")
        pkg = index.get(name)
        if not pkg:
            fail(f"package or dependency not found: {name}")
        if pkg.get("architecture", "any") not in ("any", os.uname().machine):
            fail(f"{name} is not available for {os.uname().machine}")
        visiting.add(name)
        for dep in pkg.get("depends", []):
            resolve(dep)
        visiting.remove(name)
        pending.append(pkg)

    resolve(args.name)
    if not pending:
        print(f"{args.name} is already recorded as installed.")
        return
    CACHE.mkdir(parents=True, exist_ok=True)
    downloads = []
    for pkg in pending:
        url = urllib.parse.urljoin(pkg["_repo_base"], pkg["url"])
        archive = CACHE / (pkg["name"] + "-" + pkg["version"] + ".tar.gz")
        fetch(url, archive, MAX_PACKAGE)
        digest_obj = hashlib.sha256()
        with archive.open("rb") as stream:
            for block in iter(lambda: stream.read(1024 * 1024), b""):
                digest_obj.update(block)
        digest = digest_obj.hexdigest()
        if digest.lower() != pkg["sha256"].lower():
            fail(f"SHA-256 mismatch for {pkg['name']}")
        downloads.append((pkg, archive))
    if ROOT.exists() is False:
        fail(f"target root does not exist: {ROOT}")
    extracted_manifests = []
    try:
        for pkg, archive in downloads:
            installed_files = safe_extract(archive, ROOT)
            extracted_manifests.append(installed_files)
            db[pkg["name"]] = {"version": pkg["version"], "files": installed_files}
        write_installed_db(db)
    except BaseException:
        rollback_failures = rollback_extracted(ROOT, extracted_manifests)
        if rollback_failures:
            print("vpm: warning: rollback could not remove: " +
                  ", ".join(rollback_failures), file=sys.stderr)
        raise
    print("Installed (experimental): " + ", ".join(p["name"] for p, _ in downloads))

def command_remove(args):
    if os.geteuid() != 0 and ROOT == pathlib.Path("/"):
        fail("removal from / requires root; use sudo vpm remove PACKAGE")
    db = installed_db()
    info = db.get(args.name)
    if info is None:
        fail(f"package is not recorded as installed: {args.name}")
    files = info.get("files")
    if not isinstance(files, list):
        fail("package has no trustworthy file ownership record; refusing removal")
    root = ROOT.resolve()
    targets = []
    seen_paths = set()
    # Validate the entire manifest before deleting anything. Check each path
    # component with lstat semantics (Path.is_symlink) before resolving it:
    # resolving first would hide a final-component symlink and could unlink
    # the symlink target instead of the package-owned path.
    for relative in files:
        if (not isinstance(relative, str) or not relative
                or relative.startswith("/") or "\\" in relative):
            fail("invalid installed-file record; refusing removal")
        parts = pathlib.PurePosixPath(relative).parts
        if not parts or any(part in ("", ".", "..") for part in parts):
            fail(f"invalid installed-file path: {relative}")
        normalized = pathlib.PurePosixPath(relative).as_posix()
        if normalized in seen_paths:
            fail(f"duplicate installed-file path: {relative}")
        seen_paths.add(normalized)
        candidate = root
        for part in parts:
            candidate = candidate / part
            if candidate.is_symlink():
                fail(f"refusing to follow symlink during removal: {relative}")
        target = candidate.resolve()
        if target != root and root not in target.parents:
            fail(f"installed-file record escapes target root: {relative}")
        if target.exists() and not target.is_file():
            fail(f"refusing to remove non-file package path: {relative}")
        targets.append(target)

    # Quarantine each file beside its original so a database-write failure
    # can restore files even when package paths span different filesystems.
    quarantined = []
    try:
        for target in targets:
            if not target.is_file():
                continue
            fd, backup_name = tempfile.mkstemp(
                prefix=".vpm-remove-", dir=target.parent
            )
            os.close(fd)
            os.unlink(backup_name)
            backup = pathlib.Path(backup_name)
            target.replace(backup)
            quarantined.append((backup, target))
        del db[args.name]
        write_installed_db(db)
    except BaseException:
        for backup, original in reversed(quarantined):
            try:
                backup.replace(original)
            except OSError as exc:
                print(f"vpm: warning: could not restore {original}: {exc}", file=sys.stderr)
        raise

    cleanup_failures = []
    for backup, _original in quarantined:
        try:
            backup.unlink()
        except OSError as exc:
            cleanup_failures.append(f"{backup}: {exc}")
    if cleanup_failures:
        print("vpm: warning: removed files remain in quarantine: " +
              "; ".join(cleanup_failures), file=sys.stderr)
    print(f"Removed recorded package files: {args.name}")

def main():
    parser = argparse.ArgumentParser(prog="vpm", description="Vampire Package Manager — signed software installer for Vampire OS (experimental)")
    parser.add_argument("--version", action="version", version="Vampire Package Manager 0.1.0-dev")
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("update", help="refresh and verify signed repository indexes")
    p.set_defaults(func=command_update)
    p = sub.add_parser("search", help="search available packages"); p.add_argument("query"); p.set_defaults(func=command_search)
    p = sub.add_parser("info", help="show package metadata"); p.add_argument("name"); p.set_defaults(func=command_info)
    p = sub.add_parser("list", help="list recorded installed packages"); p.set_defaults(func=command_list)
    p = sub.add_parser("install", help="download, verify and install a package"); p.add_argument("name"); p.add_argument("-y", "--yes", action="store_true", help="accept non-interactive install (the prototype currently has no prompts)"); p.set_defaults(func=command_install)
    p = sub.add_parser("remove", help="remove files recorded as owned by a package"); p.add_argument("name"); p.set_defaults(func=command_remove)
    args = parser.parse_args()
    print("VAMPIRE OS  /  VAMPIRE PACKAGE MANAGER")
    print("──────────────────────────────────────")
    args.func(args)

if __name__ == "__main__":
    main()
